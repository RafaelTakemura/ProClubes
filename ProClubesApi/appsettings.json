{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "MySql",
    "AutoInitialize": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "SqliteFallback": "Data Source=proclubes_local.db"
  },
  "Jwt": {
    "Issuer": "ProClubesApi",
    "Audience": "ProClubesClients",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "BootstrapSuperAdmin": {
    "Email": "",
    "Cpf": "",
    "Password": ""
  },
  "BackgroundJobs": {
    "Enabled": true
  }
}
