<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Cores Principais da Marca ProClubes (identidade_visual_proclubes.md) -->
    <Color x:Key="Primary">#0F2C59</Color>
    <Color x:Key="PrimaryDark">#091B38</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#1E7E5A</Color>
    <Color x:Key="SecondaryLight">#E6F4EF</Color>
    <Color x:Key="SecondaryDarkText">#0F2C59</Color>
    <Color x:Key="Tertiary">#1E7E5A</Color>
    <Color x:Key="Accent">#D97706</Color>

    <!-- Superfícies e Textos -->
    <Color x:Key="PageBackground">#F8FAFC</Color>
    <Color x:Key="CardSurface">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#475569</Color>

    <!-- Estados de Negócio (Cadastros, Mensalidades, Reservas, Votações) -->
    <Color x:Key="StatusSuccess">#16A34A</Color>
    <Color x:Key="StatusSuccessBg">#DCFCE7</Color>
    <Color x:Key="StatusWarning">#EAB308</Color>
    <Color x:Key="StatusWarningBg">#FEF9C3</Color>
    <Color x:Key="StatusDanger">#DC2626</Color>
    <Color x:Key="StatusDangerBg">#FEE2E2</Color>
    <Color x:Key="StatusInfo">#2563EB</Color>
    <Color x:Key="StatusInfoBg">#DBEAFE</Color>

    <!-- Compatibilidade Styles.xaml -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#0F172A</Color>
    <Color x:Key="Magenta">#D97706</Color>
    <Color x:Key="MidnightBlue">#091B38</Color>
    <Color x:Key="OffBlack">#0F172A</Color>

    <Color x:Key="Gray100">#F8FAFC</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#091B38</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
