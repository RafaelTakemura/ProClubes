<maui:MauiWinUIApplication
    x:Class="ProClubesApp.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:ProClubesApp.WinUI"
    RequestedTheme="Light">

    <maui:MauiWinUIApplication.Resources>
        <SolidColorBrush x:Key="TextControlForeground" Color="#0F172A" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#0F172A" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#0F172A" />
        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#64748B" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#64748B" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#64748B" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#64748B" />
        <SolidColorBrush x:Key="TextControlBackground" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F1F5F9" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#0F2C59" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0F2C59" />
    </maui:MauiWinUIApplication.Resources>

</maui:MauiWinUIApplication>
