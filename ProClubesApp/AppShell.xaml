<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProClubesApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ProClubesApp.Views"
    Title="ProClubes"
    Shell.BackgroundColor="#0F2C59"
    Shell.TitleColor="#FFFFFF"
    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarTitleColor="#0F2C59"
    Shell.TabBarUnselectedColor="#64748B">

    <TabBar>
        <ShellContent
            x:Name="TabLogin"
            Title="Login"
            ContentTemplate="{DataTemplate views:LoginCadastroPage}"
            Route="Login" />

        <ShellContent
            x:Name="TabCadastro"
            Title="Cadastro"
            ContentTemplate="{DataTemplate views:SolicitarCadastroMobilePage}"
            Route="Cadastro" />

        <ShellContent
            x:Name="TabInicio"
            Title="Início"
            ContentTemplate="{DataTemplate views:InicioMobilePage}"
            Route="Inicio" />

        <ShellContent
            x:Name="TabEventos"
            Title="Eventos"
            ContentTemplate="{DataTemplate views:EventosMobilePage}"
            Route="Eventos" />

        <ShellContent
            x:Name="TabReservas"
            Title="Reservas"
            ContentTemplate="{DataTemplate views:ReservasMobilePage}"
            Route="Reservas" />

        <ShellContent
            x:Name="TabFinanceiro"
            Title="Financeiro"
            ContentTemplate="{DataTemplate views:FinanceiroMobilePage}"
            Route="Financeiro" />

        <ShellContent
            x:Name="TabOuvidoria"
            Title="Ouvidoria"
            ContentTemplate="{DataTemplate views:OuvidoriaMobilePage}"
            Route="Ouvidoria" />

        <ShellContent
            x:Name="TabMais"
            Title="Votações"
            ContentTemplate="{DataTemplate views:MaisGovernancaMobilePage}"
            Route="Mais" />
    </TabBar>

</Shell>
