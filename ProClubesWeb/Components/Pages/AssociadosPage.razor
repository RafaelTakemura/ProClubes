    private async Task TransferirUnidadeAsync()
    {
        if (_associadoGerenciar is null) return;
        _erro = _mensagem = _erroModalGerenciar = null;
        var (_, err) = await Api.PostAsync<object>(
            $"api/v1/admin/associados/{_associadoGerenciar.Id}/transferencias",
            new TransferirAssociadoUnidadeRequest(_unidadeDestinoTransf));
        if (err is not null) { _erroModalGerenciar = err; return; }
