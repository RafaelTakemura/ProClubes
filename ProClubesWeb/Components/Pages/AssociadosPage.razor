    private async Task CadastrarDependenteAsync()
    {
        if (_associadoDependentes is null) return;
        _erro = _mensagem = _erroModalDependente = null;

        if (string.IsNullOrWhiteSpace(_depNome)
            || string.IsNullOrWhiteSpace(_depCpf)
            || string.IsNullOrWhiteSpace(_depSexo)
            || !_depNascimento.HasValue
            || string.IsNullOrWhiteSpace(_depEmail))
        {
            _erroModalDependente = "Preencha todos os campos obrigatórios (*) do dependente.";
            return;
        }

        if (!ValidarSintaxeCpf(_depCpf))
        {
            _erroModalDependente = "Sintaxe de CPF inválida. Informe 11 dígitos numéricos ou no formato 000.000.000-00.";
            return;
        }

        if (!ValidarSintaxeEmail(_depEmail))
        {
            _erroModalDependente = "Sintaxe de e-mail inválida. Informe um endereço no formato usuario@dominio.com.";
            return;
        }

        var req = new CadastrarDependenteRequest(
            _depNome, _depCpf, _depSexo, "Solteiro(a)", _depNascimento.Value,
            "Mesmo endereço do titular", "Centro", "100", _associadoDependentes.Cidade, _associadoDependentes.UF,
            _associadoDependentes.Fone, _depEmail, _depVinculo,
            string.IsNullOrWhiteSpace(_depSenha) ? null : _depSenha);

        var (_, err) = await Api.PostAsync<DependenteDto>($"api/v1/admin/associados/{_associadoDependentes.Id}/dependentes", req);
        if (err is not null) { _erroModalDependente = err; return; }
        _mensagem = "Dependente vinculado com sucesso.";
        _depNome = _depCpf = _depSexo = _depEmail = _depSenha = string.Empty;
        _depNascimento = null;
        _exibirModalNovoDependente = false;
        var (recarregado, _) = await Api.GetAsync<AssociadoDto>($"api/v1/admin/associados/{_associadoDependentes.Id}");
        if (recarregado is not null) _associadoDependentes = recarregado;
        await CarregarAsync();
    }

