    private async Task AbrirModalEditarDependente(DependenteDto dep)
    {
        await CarregarLocalidadesAsync();
        _erroModalEditarDep = null;
        _dependenteEditar = dep;
        _formEditarDep.Reset();
        _formEditarDep.Nome = dep.NomeCompleto;
        _formEditarDep.CpfSomenteLeitura = dep.CpfMascarado;
        _formEditarDep.Sexo = dep.Sexo;
        _formEditarDep.EstadoCivil = dep.EstadoCivil;
        _formEditarDep.Nascimento = dep.DataNascimento;
        _formEditarDep.Profissao = dep.Profissao;
        _formEditarDep.Fone = dep.Fone;
        _formEditarDep.Email = dep.Email;
        _formEditarDep.Logradouro = dep.Logradouro;
        _formEditarDep.Numero = dep.Numero;
        _formEditarDep.Bairro = dep.Bairro;
        _formEditarDep.UF = dep.UF;
        _formEditarDep.Cidade = dep.Cidade;
        _depVinculoEditar = dep.TipoVinculo;
