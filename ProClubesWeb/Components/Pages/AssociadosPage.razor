        _formEditarAssoc.Logradouro = a.Logradouro;
        _formEditarAssoc.Numero = a.Numero;
        _formEditarAssoc.Bairro = a.Bairro;
        _formEditarAssoc.UF = a.UF;
        _formEditarAssoc.Cidade = a.Cidade;
