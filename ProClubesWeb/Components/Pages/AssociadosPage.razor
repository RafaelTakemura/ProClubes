    {
        _erroModalNovo = null;
        _nome = string.Empty;
        _cpf = string.Empty;
        _sexo = string.Empty;
        _estadoCivil = string.Empty;
        _nascimento = null;
        _fone = string.Empty;
        _email = string.Empty;
        _cidade = string.Empty;
        _senhaNovo = string.Empty;
        _categoriaNovo = "ASSOCIADO";
        _roleInicialNovo = RoleAdministrativa.Nenhuma;
        _unidadeIdNovo = Session.UnidadeContextoId ?? Session.Usuario?.UnidadeAdministrativaId ?? (_unidades.FirstOrDefault()?.Id ?? 1);
        _exibirNovoAssociado = true;
    }

    private async Task CriarAssociadoAsync()
    {
        _erro = _mensagem = _erroModalNovo = null;

        if (string.IsNullOrWhiteSpace(_nome)
            || string.IsNullOrWhiteSpace(_cpf)
            || string.IsNullOrWhiteSpace(_sexo)
            || string.IsNullOrWhiteSpace(_estadoCivil)
            || !_nascimento.HasValue
            || string.IsNullOrWhiteSpace(_fone)
            || string.IsNullOrWhiteSpace(_email)
            || string.IsNullOrWhiteSpace(_cidade)
            || string.IsNullOrWhiteSpace(_senhaNovo))
        {
            _erroModalNovo = "Preencha todos os campos obrigatórios (*) antes de salvar.";
            return;
        }

        if (!ValidarSintaxeCpf(_cpf))
        {
            _erroModalNovo = "Sintaxe de CPF inválida. Informe 11 dígitos numéricos ou no formato 000.000.000-00.";
            return;
        }

        if (!ValidarSintaxeTelefone(_fone))
        {
            _erroModalNovo = "Sintaxe de telefone inválida. Informe DDD + número (10 ou 11 dígitos, ex.: (45) 99999-1111 ou 45999991111).";
            return;
        }

        if (!ValidarSintaxeEmail(_email))
        {
            _erroModalNovo = "Sintaxe de e-mail inválida. Informe um endereço no formato usuario@dominio.com.";
            return;
        }

        var roleInicial = Session.IsSuperAdmin ? _roleInicialNovo : RoleAdministrativa.Nenhuma;
        var req = new CriarAssociadoAdminRequest(
            _nome, _cpf, _sexo, _estadoCivil, _nascimento.Value,
            "Rua Principal", "Centro", "100", _cidade, "PR",
            _fone, _email, _unidadeIdNovo, _categoriaNovo, _senhaNovo,
            null, roleInicial);

        var (criado, err) = await Api.PostAsync<AssociadoDto>("api/v1/admin/associados", req);
        if (err is not null) { _erroModalNovo = err; return; }
        var sufixoCargo = roleInicial != RoleAdministrativa.Nenhuma ? $" com cargo de {ObterRotuloRole(roleInicial)}" : "";
        _mensagem = $"Associado {criado?.NomeCompleto} cadastrado com sucesso{sufixoCargo}.";
        _exibirNovoAssociado = false;
        _roleInicialNovo = RoleAdministrativa.Nenhuma;
        await CarregarAsync();
    }

    private static bool ValidarSintaxeCpf(string? cpf)
    {
        if (string.IsNullOrWhiteSpace(cpf)) return false;
        var s = cpf.Trim();
        var formatoAceito = System.Text.RegularExpressions.Regex.IsMatch(s, @"^(\d{11}|\d{3}\.\d{3}\.\d{3}-\d{2})$");
        if (!formatoAceito) return false;
        var digitos = new string(s.Where(char.IsDigit).ToArray());
        return digitos.Length == 11 && digitos.Distinct().Count() > 1;
    }

    private static bool ValidarSintaxeTelefone(string? fone)
    {
        if (string.IsNullOrWhiteSpace(fone)) return false;
        var s = fone.Trim();
        var formatoAceito = System.Text.RegularExpressions.Regex.IsMatch(s, @"^(\(\d{2}\)\s?\d{4,5}-?\d{4}|\d{2}\s?\d{4,5}-?\d{4}|\d{10,11})$");
        if (!formatoAceito) return false;
        var digitos = new string(s.Where(char.IsDigit).ToArray());
        return digitos.Length is 10 or 11;
    }

    private static bool ValidarSintaxeEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        var s = email.Trim();
        return System.Text.RegularExpressions.Regex.IsMatch(s, @"^[^@\s]+@[^@\s]+\.[^@\s]{2,}$");
    }

    private async Task AlterarRoleAdministrativaAsync()
    {
        if (_associadoGerenciar is null || !_associadoGerenciar.UsuarioId.HasValue) return;
        _erro = _mensagem = _erroModalGerenciar = null;
        var (_, err) = await Api.PutAsync<UnidadeDto>(
            $"api/v1/unidades/{_associadoGerenciar.UnidadeId}/administrador",
            new DesignarRoleUnidadeRequest(_associadoGerenciar.UsuarioId.Value, _novaRoleSel));
        if (err is not null) { _erroModalGerenciar = err; return; }

        var (recarregado, _) = await Api.GetAsync<AssociadoDto>($"api/v1/admin/associados/{_associadoGerenciar.Id}");
        if (recarregado is not null) _associadoGerenciar = recarregado;
        _mensagem = $"Cargo administrativo de {_associadoGerenciar.NomeCompleto} atualizado para {ObterRotuloRole(_novaRoleSel)}.";
        await CarregarAsync();
    }

    private static string ObterRotuloRole(RoleAdministrativa role) => role switch
    {
        RoleAdministrativa.SuperAdmin => "Super Admin",
        RoleAdministrativa.Admin => "Admin",
        RoleAdministrativa.Tesoureiro => "Tesoureiro",
        _ => "Associado Comum"
    };

    private static string ObterVarianteRole(RoleAdministrativa role) => role switch
    {
        RoleAdministrativa.SuperAdmin => "superadmin",
        RoleAdministrativa.Admin => "admin",
        RoleAdministrativa.Tesoureiro => "tesoureiro",
        _ => "info"
    };

