            </select>
        </div>
        <div class="pc-field"><label class="pc-label">Data de Nascimento *</label><input type="date" class="pc-input" @bind="form.Nascimento" /></div>
        <div class="pc-field"><label class="pc-label">Profissão *</label><input class="pc-input" placeholder="Ex.: Engenheiro(a), Estudante..." @bind="form.Profissao" /></div>
        <div class="pc-field"><label class="pc-label">Telefone *</label><input class="pc-input" maxlength="15" placeholder="(45) 99999-1111" @bind="form.Fone" /></div>
        <div class="pc-field"><label class="pc-label">E-mail *</label><input type="email" class="pc-input" @bind="form.Email" /></div>
        <div class="pc-field"><label class="pc-label">Logradouro</label><input class="pc-input" @bind="form.Logradouro" /></div>
        <div class="pc-field"><label class="pc-label">Número</label><input class="pc-input" @bind="form.Numero" /></div>
        <div class="pc-field"><label class="pc-label">Bairro</label><input class="pc-input" @bind="form.Bairro" /></div>
        <div class="pc-field">
            <label class="pc-label">Estado (UF)</label>
            <select class="pc-select" value="@form.UF" @onchange="e => SelecionarEstado(form, e.Value?.ToString())">
                <option value="">-- Selecione --</option>
                @foreach (var est in ObterEstadosDisponiveis(form.Cidade, form.UF))
                {
                    <option value="@est.UF">@est.Nome (@est.UF)</option>
