@page "/associados"
@implements IDisposable
@inject ProClubesApiClient Api
@inject WebSessionState Session

<PageTitle>Associados e Dependentes — ProClubesWeb</PageTitle>

@if (!Session.IsSuperAdmin && !Session.IsAdmin)
{
    <div class="pc-alert pc-alert-danger">Acesso restrito a Admin da unidade ou Super Admin.</div>
}
else
{
    <div class="pc-page-header">
        <div>
            <h1 class="pc-page-title">Associados e Dependentes</h1>
            <p class="pc-page-subtitle">Gestão de vínculos associativos, categorias, dependentes e transferências entre unidades</p>
        </div>
        <button type="button" class="pc-btn pc-btn-primary" @onclick="AbrirModalNovoAssociado">+ Cadastrar Associado</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_mensagem))
    {
        <div class="pc-alert pc-alert-success">@_mensagem</div>
    }
    @if (!string.IsNullOrWhiteSpace(_erro))
    {
        <div class="pc-alert pc-alert-danger">@_erro</div>
    }

    <PcModal IsOpen="_exibirNovoAssociado"
             Title="Novo Associado Titular"
             Subtitle="Cadastro direto de associado titular com geração automática de conta de acesso"
             MaxWidth="780px"
             OnClose="() => _exibirNovoAssociado = false">
        <ChildContent>
            @if (!string.IsNullOrWhiteSpace(_erroModalNovo))
            {
                <div class="pc-alert pc-alert-danger">@_erroModalNovo</div>
            }
            <div class="pc-form-grid">
                <div class="pc-field"><label class="pc-label">Nome Completo *</label><input class="pc-input" @bind="_nome" /></div>
                <div class="pc-field"><label class="pc-label">CPF (11 dígitos) *</label><input class="pc-input" maxlength="14" @bind="_cpf" /></div>
                <div class="pc-field">
                    <label class="pc-label">Sexo *</label>
                    <select class="pc-select" @bind="_sexo">
                        <option value="">-- Selecione --</option>
                        <option value="Masculino">Masculino</option>
                        <option value="Feminino">Feminino</option>
                        <option value="Outro">Outro</option>
                    </select>
                </div>
                <div class="pc-field">
                    <label class="pc-label">Estado Civil *</label>
                    <select class="pc-select" @bind="_estadoCivil">
                        <option value="">-- Selecione --</option>
                        <option value="Solteiro(a)">Solteiro(a)</option>
                        <option value="Casado(a)">Casado(a)</option>
                        <option value="Divorciado(a)">Divorciado(a)</option>
                        <option value="Viúvo(a)">Viúvo(a)</option>
                        <option value="União Estável">União Estável</option>
                    </select>
                </div>
                <div class="pc-field"><label class="pc-label">Data de Nascimento *</label><input type="date" class="pc-input" @bind="_nascimento" /></div>
                <div class="pc-field"><label class="pc-label">Telefone *</label><input class="pc-input" maxlength="15" @bind="_fone" /></div>
                <div class="pc-field"><label class="pc-label">E-mail *</label><input type="email" class="pc-input" @bind="_email" /></div>
                <div class="pc-field">
                    <label class="pc-label">Unidade *</label>
                    <select class="pc-select" @bind="_unidadeIdNovo">
                        @foreach (var u in _unidades)
                        {
                            <option value="@u.Id">@u.Nome (@u.Sigla)</option>
                        }
                    </select>
                </div>
                <div class="pc-field">
                    <label class="pc-label">Categoria Associativa *</label>
                    <select class="pc-select" @bind="_categoriaNovo">
                        <option value="ASSOCIADO">Sócio Associado</option>
                        <option value="FUNDADOR">Sócio Fundador</option>
                        <option value="CONVIDADO">Sócio Convidado</option>
                        <option value="SIMPATIZANTE">Simpatizante</option>
                    </select>
                </div>
                @if (Session.IsSuperAdmin)
                {
                    <div class="pc-field">
                        <label class="pc-label">Cargo Administrativo Inicial</label>
                        <select class="pc-select" @bind="_roleInicialNovo">
                            <option value="@RoleAdministrativa.Nenhuma">Associado Comum (Sem cargo)</option>
                            <option value="@RoleAdministrativa.Admin">Admin da Unidade</option>
                            <option value="@RoleAdministrativa.Tesoureiro">Tesoureiro da Unidade</option>
                        </select>
                    </div>
                }
                <div class="pc-field"><label class="pc-label">Cidade / UF *</label><input class="pc-input" @bind="_cidade" /></div>
                <div class="pc-field"><label class="pc-label">Senha Inicial *</label><input type="password" class="pc-input" @bind="_senhaNovo" /></div>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _exibirNovoAssociado = false">Cancelar</button>
            <button type="button" class="pc-btn pc-btn-primary" @onclick="CriarAssociadoAsync">Salvar Associado</button>
        </FooterContent>
    </PcModal>

    <div class="pc-card">
        <div style="display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap;">
            <input class="pc-input" style="min-width: 240px;" placeholder="Buscar por nome, e-mail ou CPF..." @bind="_busca" />
            <select class="pc-select" @bind="_filtroCategoria">
                <option value="">Todas as categorias</option>
                <option value="ASSOCIADO">Sócio Associado</option>
                <option value="FUNDADOR">Sócio Fundador</option>
                <option value="CONVIDADO">Sócio Convidado</option>
                <option value="SIMPATIZANTE">Simpatizante</option>
            </select>
            <button type="button" class="pc-btn pc-btn-outline" @onclick="CarregarAsync">Buscar</button>
        </div>

        <div class="pc-table-wrap">
            <table class="pc-table">
                <thead>
                    <tr>
                        <th>ID / Usuário</th>
                        <th>Associado</th>
                        <th>Unidade</th>
                        <th>Categoria</th>
                        <th>Status / Cobrança</th>
                        <th>Dependentes Ativos</th>
                        <th>Ações Administrativas</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_associados.Count == 0)
                    {
                        <tr><td colspan="7">Nenhum associado encontrado.</td></tr>
                    }
                    @foreach (var a in _associados)
                    {
                        <tr>
                            <td>Assoc #@a.Id<br /><small style="color: var(--pc-text-secondary);">Usr #@(a.UsuarioId?.ToString() ?? "-")</small></td>
                            <td>
                                <strong>@a.NomeCompleto</strong>
                                @if (a.RoleAdministrativa != RoleAdministrativa.Nenhuma)
                                {
                                    <span style="margin-left: 6px;">
                                        <PcStatusBadge Text="@ObterRotuloRole(a.RoleAdministrativa)" Variant="@ObterVarianteRole(a.RoleAdministrativa)" />
                                    </span>
                                }
                                <br /><small>@a.CpfMascarado — @a.Email</small>
                            </td>
                            <td>@a.UnidadeNome</td>
                            <td>
                                <PcStatusBadge Text="@a.CategoriaNome" Variant="@(a.CategoriaCodigo == "FUNDADOR" ? "fundador" : (a.CategoriaCodigo == "SIMPATIZANTE" ? "simpatizante" : "info"))" />
                            </td>
                            <td>
                                <PcStatusBadge Text="@a.Status.ToString()" Variant="@(a.Status == StatusAssociado.Ativo ? "ativo" : "inativo")" />
                                @if (a.DataInicioCobranca.HasValue)
                                {
                                    <div><small>Cobrança: @a.DataInicioCobranca.Value.ToString("MM/yyyy")</small></div>
                                }
                            </td>
                            <td>@a.Dependentes.Count(d => d.Ativo)</td>
                            <td>
                                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                    <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="() => AbrirModalGerenciar(a)">Gerenciar</button>
                                    <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="() => AbrirModalDependentes(a)">Dependentes (@a.Dependentes.Count(d => d.Ativo))</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_associadoGerenciar is not null)
    {
        <PcModal IsOpen="true"
                 Title="@($"Gerenciar Associado — {_associadoGerenciar.NomeCompleto}")"
                 Subtitle="@($"Unidade: {_associadoGerenciar.UnidadeNome} | Categoria atual: {_associadoGerenciar.CategoriaNome} | Cargo: {ObterRotuloRole(_associadoGerenciar.RoleAdministrativa)}")"
                 MaxWidth="880px"
                 OnClose="() => _associadoGerenciar = null">
            <ChildContent>
                @if (!string.IsNullOrWhiteSpace(_erroModalGerenciar))
                {
                    <div class="pc-alert pc-alert-danger">@_erroModalGerenciar</div>
                }

                <h4 style="margin-top: 0; margin-bottom: 12px;">Informações Cadastrais e Associativas</h4>
                <div style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 16px; margin-bottom: 20px;">
                    <div class="pc-form-grid" style="gap: 12px;">
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Nome Completo</small>
                            <strong>@_associadoGerenciar.NomeCompleto</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">CPF</small>
                            <strong>@_associadoGerenciar.CpfMascarado</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Data de Nascimento</small>
                            <strong>@_associadoGerenciar.DataNascimento.ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Sexo / Estado Civil</small>
                            <strong>@_associadoGerenciar.Sexo — @_associadoGerenciar.EstadoCivil</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">E-mail</small>
                            <strong>@_associadoGerenciar.Email</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Telefone</small>
                            <strong>@_associadoGerenciar.Fone</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Cidade / UF</small>
                            <strong>@_associadoGerenciar.Cidade / @_associadoGerenciar.UF</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Unidade Atual</small>
                            <strong>@_associadoGerenciar.UnidadeNome</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Categoria Associativa</small>
                            <PcStatusBadge Text="@($"{_associadoGerenciar.CategoriaNome} ({_associadoGerenciar.CategoriaCodigo})")"
                                           Variant="@(_associadoGerenciar.CategoriaCodigo == "FUNDADOR" ? "fundador" : (_associadoGerenciar.CategoriaCodigo == "SIMPATIZANTE" ? "simpatizante" : "info"))" />
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Cargo Administrativo</small>
                            <PcStatusBadge Text="@ObterRotuloRole(_associadoGerenciar.RoleAdministrativa)"
                                           Variant="@ObterVarianteRole(_associadoGerenciar.RoleAdministrativa)" />
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Status do Vínculo</small>
                            <PcStatusBadge Text="@_associadoGerenciar.Status.ToString()"
                                           Variant="@(_associadoGerenciar.Status == StatusAssociado.Ativo ? "ativo" : "inativo")" />
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Data de Ingresso</small>
                            <strong>@_associadoGerenciar.DataIngresso.ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Início de Cobrança</small>
                            <strong>@(_associadoGerenciar.DataInicioCobranca?.ToString("dd/MM/yyyy (MM/yyyy)") ?? "Isento de mensalidade")</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Dependentes</small>
                            <strong>@_associadoGerenciar.Dependentes.Count(d => d.Ativo) ativo(s) de @_associadoGerenciar.Dependentes.Count total</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Interesses</small>
                            <strong>@(_associadoGerenciar.Interesses.Count > 0 ? string.Join(", ", _associadoGerenciar.Interesses) : "Nenhum informado")</strong>
                        </div>
                    </div>
                </div>

                <h4 style="margin-top: 0; margin-bottom: 12px;">Ações de Gerenciamento</h4>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 16px;">
                    <div class="pc-field" style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 14px; margin-bottom: 0;">
                        <label class="pc-label">Alterar Categoria (efeito na próxima competência)</label>
                        <div style="display: flex; gap: 10px; align-items: center;">
                            <select class="pc-select" style="flex: 1;" @bind="_novaCategoriaSel">
                                <option value="ASSOCIADO">Sócio Associado</option>
                                <option value="FUNDADOR">Sócio Fundador</option>
                                <option value="CONVIDADO">Sócio Convidado</option>
                                <option value="SIMPATIZANTE">Simpatizante</option>
                            </select>
                            <button type="button" class="pc-btn pc-btn-primary" @onclick="AlterarCategoriaAsync">Aplicar</button>
                        </div>
                    </div>

                    @if (Session.IsSuperAdmin && _associadoGerenciar.UsuarioId.HasValue)
                    {
                        <div class="pc-field" style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 14px; margin-bottom: 0;">
                            <label class="pc-label">Cargo Administrativo na Unidade (Exclusivo Super Admin)</label>
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <select class="pc-select" style="flex: 1;" @bind="_novaRoleSel">
                                    <option value="@RoleAdministrativa.Nenhuma">Sem cargo (Associado Comum)</option>
                                    <option value="@RoleAdministrativa.Admin">Admin da Unidade</option>
                                    <option value="@RoleAdministrativa.Tesoureiro">Tesoureiro da Unidade</option>
                                </select>
                                <button type="button" class="pc-btn pc-btn-primary" @onclick="AlterarRoleAdministrativaAsync">Aplicar Cargo</button>
                            </div>
                        </div>
                    }

                    @if (Session.IsSuperAdmin)
                    {
                        <div class="pc-field" style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 14px; margin-bottom: 0;">
                            <label class="pc-label">Transferir para outra Unidade (Exclusivo Super Admin)</label>
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <select class="pc-select" style="flex: 1;" @bind="_unidadeDestinoTransf">
                                    @foreach (var u in _unidades)
                                    {
                                        <option value="@u.Id">@u.Nome (@u.Sigla)</option>
                                    }
                                </select>
                                <button type="button" class="pc-btn pc-btn-secondary" @onclick="TransferirUnidadeAsync">Transferir</button>
                            </div>
                        </div>
                    }

                    <div class="pc-field" style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 14px; margin-bottom: 0;">
                        <label class="pc-label">Situação do Vínculo</label>
                        <div>
                            @if (_associadoGerenciar.Status == StatusAssociado.Ativo)
                            {
                                <button type="button" class="pc-btn pc-btn-danger" @onclick="() => AlterarStatusAsync(false)">Desativar Associado</button>
                            }
                            else
                            {
                                <button type="button" class="pc-btn pc-btn-primary" @onclick="() => AlterarStatusAsync(true)">Reativar Associado</button>
                            }
                        </div>
                    </div>
                </div>
            </ChildContent>
            <FooterContent>
                <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _associadoGerenciar = null">Fechar</button>
            </FooterContent>
        </PcModal>
    }

    @if (_associadoDependentes is not null)
    {
        <PcModal IsOpen="true"
                 Title="@($"Dependentes de {_associadoDependentes.NomeCompleto}")"
                 Subtitle="Cônjuge ou Filho(a) até 21 anos, inclusive"
                 MaxWidth="820px"
                 OnClose="() => { _associadoDependentes = null; _exibirModalNovoDependente = false; }">
            <ChildContent>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 10px;">
                    <h4 style="margin: 0;">Dependentes Vinculados</h4>
                    <button type="button" class="pc-btn pc-btn-primary pc-btn-sm" @onclick="AbrirModalNovoDependente">+ Cadastrar Dependente</button>
                </div>

                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>CPF</th>
                            <th>Vínculo</th>
                            <th>Nascimento</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_associadoDependentes.Dependentes.Count == 0)
                        {
                            <tr><td colspan="5">Nenhum dependente registrado.</td></tr>
                        }
                        @foreach (var d in _associadoDependentes.Dependentes)
                        {
                            <tr>
                                <td>@d.NomeCompleto</td>
                                <td>@d.CpfMascarado</td>
                                <td>@d.TipoVinculo</td>
                                <td>@d.DataNascimento.ToString("dd/MM/yyyy")</td>
                                <td><PcStatusBadge Text="@(d.Ativo ? "Ativo" : $"Encerrado ({d.MotivoFim})")" Variant="@(d.Ativo ? "ativo" : "neutral")" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </ChildContent>
            <FooterContent>
                <button type="button" class="pc-btn pc-btn-outline" @onclick="() => { _associadoDependentes = null; _exibirModalNovoDependente = false; }">Fechar</button>
            </FooterContent>
        </PcModal>

        <PcModal IsOpen="_exibirModalNovoDependente"
                 Title="@($"Cadastrar Dependente — Titular: {_associadoDependentes.NomeCompleto}")"
                 Subtitle="Informe os dados do cônjuge ou filho(a) até 21 anos"
                 MaxWidth="680px"
                 OnClose="() => _exibirModalNovoDependente = false">
            <ChildContent>
                @if (!string.IsNullOrWhiteSpace(_erroModalDependente))
                {
                    <div class="pc-alert pc-alert-danger">@_erroModalDependente</div>
                }
                <div class="pc-form-grid">
                    <div class="pc-field"><label class="pc-label">Nome Completo *</label><input class="pc-input" @bind="_depNome" /></div>
                    <div class="pc-field"><label class="pc-label">CPF *</label><input class="pc-input" maxlength="14" @bind="_depCpf" /></div>
                    <div class="pc-field">
                        <label class="pc-label">Sexo *</label>
                        <select class="pc-select" @bind="_depSexo">
                            <option value="">-- Selecione --</option>
                            <option value="Masculino">Masculino</option>
                            <option value="Feminino">Feminino</option>
                            <option value="Outro">Outro</option>
                        </select>
                    </div>
                    <div class="pc-field"><label class="pc-label">Data de Nascimento *</label><input type="date" class="pc-input" @bind="_depNascimento" /></div>
                    <div class="pc-field">
                        <label class="pc-label">Tipo de Vínculo *</label>
                        <select class="pc-select" @bind="_depVinculo">
                            <option value="@TipoVinculoDependente.Conjuge">Cônjuge</option>
                            <option value="@TipoVinculoDependente.Filho">Filho(a) (até 21 anos)</option>
                        </select>
                    </div>
                    <div class="pc-field"><label class="pc-label">E-mail *</label><input type="email" class="pc-input" @bind="_depEmail" /></div>
                    <div class="pc-field"><label class="pc-label">Senha (para login próprio opcional)</label><input type="password" class="pc-input" @bind="_depSenha" /></div>
                </div>
            </ChildContent>
            <FooterContent>
                <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _exibirModalNovoDependente = false">Cancelar</button>
                <button type="button" class="pc-btn pc-btn-primary" @onclick="CadastrarDependenteAsync">Salvar Dependente</button>
            </FooterContent>
        </PcModal>
    }
}

@code {
    private IReadOnlyList<AssociadoDto> _associados = Array.Empty<AssociadoDto>();
    private IReadOnlyList<UnidadeDto> _unidades = Array.Empty<UnidadeDto>();
    private AssociadoDto? _associadoGerenciar;
    private AssociadoDto? _associadoDependentes;
    private bool _exibirModalNovoDependente;
    private string? _erroModalGerenciar;
    private string? _erroModalDependente;
    private string _busca = string.Empty;
    private string _filtroCategoria = string.Empty;
    private string? _erro;
    private string? _mensagem;

    private bool _exibirNovoAssociado;
    private string? _erroModalNovo;
    private string _nome = string.Empty;
    private string _cpf = string.Empty;
    private string _sexo = string.Empty;
    private string _estadoCivil = string.Empty;
    private DateOnly? _nascimento;
    private string _fone = string.Empty;
    private string _email = string.Empty;
    private string _cidade = string.Empty;
    private int _unidadeIdNovo = 1;
    private string _categoriaNovo = "ASSOCIADO";
    private RoleAdministrativa _roleInicialNovo = RoleAdministrativa.Nenhuma;
    private string _senhaNovo = string.Empty;

    private string _novaCategoriaSel = "ASSOCIADO";
    private RoleAdministrativa _novaRoleSel = RoleAdministrativa.Nenhuma;
    private int _unidadeDestinoTransf = 2;

    private string _depNome = string.Empty;
    private string _depCpf = string.Empty;
    private string _depSexo = string.Empty;
    private DateOnly? _depNascimento;
    private TipoVinculoDependente _depVinculo = TipoVinculoDependente.Filho;
    private string _depEmail = string.Empty;
    private string _depSenha = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += HandleContextChanged;
        _unidadeIdNovo = Session.UnidadeContextoId ?? Session.Usuario?.UnidadeAdministrativaId ?? 1;
        await CarregarUnidadesAsync();
        await CarregarAsync();
    }

    private async void HandleContextChanged()
    {
        if (Session.UnidadeContextoId.HasValue)
            _unidadeIdNovo = Session.UnidadeContextoId.Value;
        await CarregarAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CarregarUnidadesAsync()
    {
        var (data, _) = await Api.GetAsync<IReadOnlyList<UnidadeDto>>("api/v1/unidades");
        if (data is not null && data.Count > 0)
        {
            _unidades = data;
            if (!_unidades.Any(u => u.Id == _unidadeIdNovo))
                _unidadeIdNovo = _unidades[0].Id;
        }
    }

    private async Task CarregarAsync()
    {
        _erro = null;
        var q = new List<string> { "page=1", "pageSize=50" };
        if (Session.UnidadeContextoId.HasValue) q.Add($"unidadeId={Session.UnidadeContextoId.Value}");
        if (!string.IsNullOrWhiteSpace(_filtroCategoria)) q.Add($"codigoCategoria={_filtroCategoria}");
        if (!string.IsNullOrWhiteSpace(_busca)) q.Add($"busca={Uri.EscapeDataString(_busca)}");

        var (data, err) = await Api.GetAsync<PagedResponse<AssociadoDto>>($"api/v1/admin/associados?{string.Join("&", q)}");
        if (data is not null) _associados = data.Items;
        _erro = err;
    }

    private void AbrirModalGerenciar(AssociadoDto a)
    {
        _erroModalGerenciar = null;
        _associadoDependentes = null;
        _associadoGerenciar = a;
        _novaCategoriaSel = a.CategoriaCodigo;
        _novaRoleSel = a.RoleAdministrativa == RoleAdministrativa.SuperAdmin
            ? RoleAdministrativa.Nenhuma
            : a.RoleAdministrativa;
        var outraUnidade = _unidades.FirstOrDefault(u => u.Id != a.UnidadeId);
        if (outraUnidade is not null)
            _unidadeDestinoTransf = outraUnidade.Id;
    }

