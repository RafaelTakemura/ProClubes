@page "/associados"
@implements IDisposable
@inject ProClubesApiClient Api
@inject WebSessionState Session

<PageTitle>Associados e Dependentes — ProClubesWeb</PageTitle>

@if (!Session.IsSuperAdmin && !Session.IsAdmin)
{
    <div class="pc-alert pc-alert-danger">Acesso restrito a Admin da unidade ou Super Admin.</div>
}
else
{
    <div class="pc-page-header">
        <div class="pc-header-titles">
            <span class="pc-badge-eyebrow">ProClubes Enterprise • Quadro Associativo</span>
            <h1 class="pc-title">Associados e Dependentes</h1>
            <p class="pc-subtitle">Gestão de vínculos associativos, categorias, dependentes, edição cadastral e transferências entre unidades.</p>
        </div>
        <div class="pc-header-actions">
            <button type="button" class="pc-btn pc-btn-primary" @onclick="AbrirModalNovoAssociado">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Cadastrar Associado
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_mensagem))
    {
        <div class="pc-alert pc-alert-success" role="status">@_mensagem</div>
    }
    @if (!string.IsNullOrWhiteSpace(_erro))
    {
        <div class="pc-alert pc-alert-danger" role="alert">@_erro</div>
    }

    <PcModal IsOpen="_exibirNovoAssociado"
             Title="Novo Associado Titular"
             Subtitle="Cadastro direto de associado titular com geração automática de conta de acesso"
             MaxWidth="820px"
             OnClose="() => _exibirNovoAssociado = false">
        <ChildContent>
            @if (!string.IsNullOrWhiteSpace(_erroModalNovo))
            {
                <div class="pc-alert pc-alert-danger">@_erroModalNovo</div>
            }
            <div class="pc-form-grid">
                @RenderCamposPessoa(_formNovoAssoc, cpfSomenteLeitura: false)
                <div class="pc-field">
                    <label class="pc-label">Unidade *</label>
                    <select class="pc-select" @bind="_unidadeIdNovo">
                        @foreach (var u in _unidades)
                        {
                            <option value="@u.Id">@u.Nome (@u.Sigla)</option>
                        }
                    </select>
                </div>
                <div class="pc-field">
                    <label class="pc-label">Categoria Associativa *</label>
                    <select class="pc-select" @bind="_categoriaNovo">
                        <option value="ASSOCIADO">Sócio Associado</option>
                        <option value="FUNDADOR">Sócio Fundador</option>
                        <option value="CONVIDADO">Sócio Convidado</option>
                        <option value="SIMPATIZANTE">Simpatizante</option>
                    </select>
                </div>
                @if (Session.IsSuperAdmin)
                {
                    <div class="pc-field">
                        <label class="pc-label">Cargo Administrativo Inicial</label>
                        <select class="pc-select" @bind="_roleInicialNovo">
                            <option value="@RoleAdministrativa.Nenhuma">Associado Comum (Sem cargo)</option>
                            <option value="@RoleAdministrativa.Admin">Admin da Unidade</option>
                            <option value="@RoleAdministrativa.Tesoureiro">Tesoureiro da Unidade</option>
                        </select>
                    </div>
                }
                <div class="pc-field"><label class="pc-label">Senha Inicial *</label><input type="password" class="pc-input" @bind="_senhaNovo" /></div>
            </div>
            <div class="pc-alert pc-alert-info" style="margin-top: 14px; margin-bottom: 0; font-size: 13px;">
                Ao salvar, será gerado automaticamente um <strong>Contrato de Adesão</strong> com número único e o associado permanecerá em <strong>Aguardando Aceite de Contrato</strong> até confirmar o aceite no aplicativo (quando suas permissões e cobranças serão ativadas).
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _exibirNovoAssociado = false">Cancelar</button>
            <button type="button" class="pc-btn pc-btn-primary" @onclick="CriarAssociadoAsync">Salvar Associado</button>
        </FooterContent>
    </PcModal>

    <div class="pc-card">
        <div style="display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap;">
            <input class="pc-input" style="min-width: 260px; flex: 1;" placeholder="Buscar por nome, e-mail ou CPF..." @bind="_busca" />
            <select class="pc-select" @bind="_filtroCategoria" @bind:after="CarregarAsync">
                <option value="">Todas as categorias</option>
                <option value="ASSOCIADO">Sócio Associado</option>
                <option value="FUNDADOR">Sócio Fundador</option>
                <option value="CONVIDADO">Sócio Convidado</option>
                <option value="SIMPATIZANTE">Simpatizante</option>
            </select>
            <select class="pc-select" @bind="_filtroStatus" @bind:after="CarregarAsync" aria-label="Filtrar por status">
                <option value="">Todos os status</option>
                <option value="Ativo">Ativo</option>
                <option value="AguardandoAceiteContrato">Aguardando Aceite de Contrato</option>
                <option value="Inativo">Inativo</option>
            </select>
            <button type="button" class="pc-btn pc-btn-outline" @onclick="CarregarAsync">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                Buscar
            </button>
        </div>

        <div class="pc-table-wrap">
            <table class="pc-table">
                <thead>
                    <tr>
                        <th>ID / Usuário</th>
                        <th>Associado</th>
                        <th>Unidade</th>
                        <th>Categoria</th>
                        <th>Status / Contrato / Cobrança</th>
                        <th>Dependentes Ativos</th>
                        <th>Ações Administrativas</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_associados.Count == 0)
                    {
                        <tr><td colspan="7">Nenhum associado encontrado.</td></tr>
                    }
                    @foreach (var a in _associados)
                    {
                        <tr>
                            <td>Assoc #@a.Id<br /><small style="color: var(--pc-text-muted);">Usr #@(a.UsuarioId?.ToString() ?? "-")</small></td>
                            <td>
                                <div class="pc-user-info">
                                    <div class="pc-avatar">@ObterIniciais(a.NomeCompleto)</div>
                                    <div>
                                        <div class="pc-user-name">
                                            @a.NomeCompleto
                                            @if (a.RoleAdministrativa != RoleAdministrativa.Nenhuma)
                                            {
                                                <span style="margin-left: 6px;">
                                                    <PcStatusBadge Text="@ObterRotuloRole(a.RoleAdministrativa)" Variant="@ObterVarianteRole(a.RoleAdministrativa)" />
                                                </span>
                                            }
                                        </div>
                                        <div class="pc-user-meta">@a.CpfMascarado — @a.Email</div>
                                        @if (!string.IsNullOrWhiteSpace(a.Profissao))
                                        {
                                            <div class="pc-user-meta">@a.Profissao</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>@a.UnidadeNome</td>
                            <td>
                                <PcStatusBadge Text="@a.CategoriaNome" Variant="@(a.CategoriaCodigo == "FUNDADOR" ? "fundador" : (a.CategoriaCodigo == "SIMPATIZANTE" ? "simpatizante" : "info"))" />
                            </td>
                            <td>
                                <PcStatusBadge Text="@WebFormatHelpers.ObterRotuloStatusAssociado(a.Status)"
                                               Variant="@WebFormatHelpers.ObterVarianteStatusAssociado(a.Status)" />
                                @if (!string.IsNullOrWhiteSpace(a.NumeroContratoAtual))
                                {
                                    <div>
                                        <small style="color: var(--pc-text-secondary);">
                                            Contrato @a.NumeroContratoAtual (@WebFormatHelpers.ObterRotuloStatusContrato(a.StatusContratoAtual ?? StatusContrato.PendenteAceite))
                                        </small>
                                    </div>
                                }
                                @if (a.Status == StatusAssociado.Ativo && a.DataInicioCobranca.HasValue)
                                {
                                    <div><small>Cobrança: @a.DataInicioCobranca.Value.ToString("MM/yyyy")</small></div>
                                }
                            </td>
                            <td>@a.Dependentes.Count(d => d.Ativo)</td>
                            <td>
                                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                    <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="() => AbrirModalGerenciar(a)">Gerenciar</button>
                                    <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="() => AbrirModalEditarAssociado(a)">Editar Dados</button>
                                    <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="() => AbrirModalDependentes(a)">Dependentes (@a.Dependentes.Count(d => d.Ativo))</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_associadoGerenciar is not null)
    {
        <PcModal IsOpen="true"
                 Title="@($"Gerenciar Associado — {_associadoGerenciar.NomeCompleto}")"
                 Subtitle="@($"Unidade: {_associadoGerenciar.UnidadeNome} | Categoria atual: {_associadoGerenciar.CategoriaNome} | Cargo: {ObterRotuloRole(_associadoGerenciar.RoleAdministrativa)}")"
                 MaxWidth="880px"
                 OnClose="() => _associadoGerenciar = null">
            <ChildContent>
                @if (!string.IsNullOrWhiteSpace(_erroModalGerenciar))
                {
                    <div class="pc-alert pc-alert-danger">@_erroModalGerenciar</div>
                }

                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; gap: 8px; flex-wrap: wrap;">
                    <h4 style="margin: 0;">Informações Cadastrais e Associativas</h4>
                    <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="() => AbrirModalEditarAssociado(_associadoGerenciar)">Editar Dados Cadastrais</button>
                </div>

                <div style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 16px; margin-bottom: 20px;">
                    <div class="pc-form-grid" style="gap: 12px;">
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Nome Completo</small>
                            <strong>@_associadoGerenciar.NomeCompleto</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">CPF (imutável)</small>
                            <strong>@_associadoGerenciar.CpfMascarado</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Data de Nascimento</small>
                            <strong>@_associadoGerenciar.DataNascimento.ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Sexo / Estado Civil</small>
                            <strong>@_associadoGerenciar.Sexo — @_associadoGerenciar.EstadoCivil</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Profissão</small>
                            <strong>@(string.IsNullOrWhiteSpace(_associadoGerenciar.Profissao) ? "Não informada" : _associadoGerenciar.Profissao)</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">E-mail</small>
                            <strong>@_associadoGerenciar.Email</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Telefone</small>
                            <strong>@_associadoGerenciar.Fone</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Endereço</small>
                            <strong>@ObterEnderecoFormatado(_associadoGerenciar)</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Unidade Atual</small>
                            <strong>@_associadoGerenciar.UnidadeNome</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Categoria Associativa</small>
                            <PcStatusBadge Text="@($"{_associadoGerenciar.CategoriaNome} ({_associadoGerenciar.CategoriaCodigo})")"
                                           Variant="@(_associadoGerenciar.CategoriaCodigo == "FUNDADOR" ? "fundador" : (_associadoGerenciar.CategoriaCodigo == "SIMPATIZANTE" ? "simpatizante" : "info"))" />
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Cargo Administrativo</small>
                            <PcStatusBadge Text="@ObterRotuloRole(_associadoGerenciar.RoleAdministrativa)"
                                           Variant="@ObterVarianteRole(_associadoGerenciar.RoleAdministrativa)" />
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Status do Vínculo</small>
                            <PcStatusBadge Text="@WebFormatHelpers.ObterRotuloStatusAssociado(_associadoGerenciar.Status)"
                                           Variant="@WebFormatHelpers.ObterVarianteStatusAssociado(_associadoGerenciar.Status)" />
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Contrato Atual</small>
                            <strong>@(!string.IsNullOrWhiteSpace(_associadoGerenciar.NumeroContratoAtual) ? $"{_associadoGerenciar.NumeroContratoAtual} ({WebFormatHelpers.ObterRotuloStatusContrato(_associadoGerenciar.StatusContratoAtual ?? StatusContrato.PendenteAceite)})" : "Nenhum contrato vinculado")</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Data de Ingresso</small>
                            <strong>@_associadoGerenciar.DataIngresso.ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Início de Cobrança</small>
                            <strong>@(_associadoGerenciar.DataInicioCobranca?.ToString("dd/MM/yyyy (MM/yyyy)") ?? "Sem cobrança ativa / Isento")</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Dependentes</small>
                            <strong>@_associadoGerenciar.Dependentes.Count(d => d.Ativo) ativo(s) de @_associadoGerenciar.Dependentes.Count total</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Data de Cadastro</small>
                            <strong>@(_associadoGerenciar.CriadoEm?.ToString("dd/MM/yyyy HH:mm") ?? _associadoGerenciar.DataIngresso.ToString("dd/MM/yyyy"))</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Última Alteração / Usuário</small>
                            <strong>@(_associadoGerenciar.AtualizadoEm?.ToString("dd/MM/yyyy HH:mm") ?? "Sem alterações")</strong>
                            <div><small style="color: var(--pc-text-muted);">Por: @(_associadoGerenciar.UltimaAlteracaoPorNome ?? "Sistema / Cadastro inicial")</small></div>
                        </div>
                        <div style="grid-column: 1 / -1;">
                            <small style="color: var(--pc-text-secondary); display: block;">Interesses</small>
                            <strong>@(_associadoGerenciar.Interesses.Count > 0 ? string.Join(", ", _associadoGerenciar.Interesses) : "Nenhum informado")</strong>
                        </div>
                    </div>
                </div>

                <h4 style="margin-top: 0; margin-bottom: 12px;">Ações de Gerenciamento</h4>
                @if (_associadoGerenciar.Status == StatusAssociado.AguardandoAceiteContrato)
                {
                    <div class="pc-alert pc-alert-warning" style="margin-bottom: 14px;">
                        Este associado foi aprovado e encontra-se <strong>Aguardando Aceite de Contrato</strong>. Permissões e cobranças mensais serão liberadas somente após o aceite no aplicativo.
                    </div>
                }
                else if (_associadoGerenciar.Status == StatusAssociado.Inativo)
                {
                    <div class="pc-alert pc-alert-warning" style="margin-bottom: 14px;">
                        Este associado encontra-se <strong>Inativo</strong>. As ações de alteração de categoria, designação de cargo administrativo e transferência de unidade ficam disponíveis apenas para associados ativos.
                    </div>
                }
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 16px;">
                    @if (_associadoGerenciar.Status == StatusAssociado.Ativo)
                    {
                        <div class="pc-field" style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 14px; margin-bottom: 0;">
                            <label class="pc-label">Alterar Categoria (efeito na próxima competência)</label>
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <select class="pc-select" style="flex: 1;" @bind="_novaCategoriaSel">
                                    <option value="ASSOCIADO">Sócio Associado</option>
                                    <option value="FUNDADOR">Sócio Fundador</option>
                                    <option value="CONVIDADO">Sócio Convidado</option>
                                    <option value="SIMPATIZANTE">Simpatizante</option>
                                </select>
                                <button type="button" class="pc-btn pc-btn-primary" @onclick="AlterarCategoriaAsync">Aplicar</button>
                            </div>
                        </div>

                        @if (Session.IsSuperAdmin && _associadoGerenciar.UsuarioId.HasValue)
                        {
                            <div class="pc-field" style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 14px; margin-bottom: 0;">
                                <label class="pc-label">Cargo Administrativo na Unidade (Exclusivo Super Admin)</label>
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    <select class="pc-select" style="flex: 1;" @bind="_novaRoleSel">
                                        <option value="@RoleAdministrativa.Nenhuma">Sem cargo (Associado Comum)</option>
                                        <option value="@RoleAdministrativa.Admin">Admin da Unidade</option>
                                        <option value="@RoleAdministrativa.Tesoureiro">Tesoureiro da Unidade</option>
                                    </select>
                                    <button type="button" class="pc-btn pc-btn-primary" @onclick="AlterarRoleAdministrativaAsync">Aplicar Cargo</button>
                                </div>
                            </div>
                        }

                        @if (Session.IsSuperAdmin)
                        {
                            <div class="pc-field" style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 14px; margin-bottom: 0;">
                                <label class="pc-label">Transferir para outra Unidade (Exclusivo Super Admin)</label>
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    <select class="pc-select" style="flex: 1;" @bind="_unidadeDestinoTransf">
                                        @foreach (var u in _unidades)
                                        {
                                            <option value="@u.Id">@u.Nome (@u.Sigla)</option>
                                        }
                                    </select>
                                    <button type="button" class="pc-btn pc-btn-secondary" @onclick="TransferirUnidadeAsync">Transferir</button>
                                </div>
                            </div>
                        }
                    }

                    @if (_associadoGerenciar.Status == StatusAssociado.AguardandoAceiteContrato || _associadoGerenciar.Status == StatusAssociado.Inativo)
                    {
                        <div class="pc-field" style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 14px; margin-bottom: 0;">
                            <label class="pc-label">Gestão de Contrato de Adesão</label>
                            <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                                <button type="button" class="pc-btn pc-btn-primary" @onclick="RegerarContratoGerenciarAsync">Regerar Contrato</button>
                                <small style="color: var(--pc-text-muted);">Emite novo contrato para aceite no app.</small>
                            </div>
                        </div>
                    }

                    <div class="pc-field" style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 14px; margin-bottom: 0;">
                        <label class="pc-label">Situação do Vínculo</label>
                        <div>
                            @if (_associadoGerenciar.Status == StatusAssociado.Ativo || _associadoGerenciar.Status == StatusAssociado.AguardandoAceiteContrato)
                            {
                                <button type="button" class="pc-btn pc-btn-danger" @onclick="() => AlterarStatusAsync(false)">Desativar Associado</button>
                            }
                            else
                            {
                                <button type="button" class="pc-btn pc-btn-primary" @onclick="() => AlterarStatusAsync(true)">Reativar Associado</button>
                            }
                        </div>
                    </div>
                </div>
            </ChildContent>
            <FooterContent>
                <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _associadoGerenciar = null">Fechar</button>
            </FooterContent>
        </PcModal>
    }

    @if (_associadoEditarDados is not null)
    {
        <PcModal IsOpen="true"
                 Title="@($"Editar Dados Cadastrais — {_associadoEditarDados.NomeCompleto}")"
                 Subtitle="Atualize os dados do associado (CPF não pode ser alterado)"
                 MaxWidth="820px"
                 OnClose="() => _associadoEditarDados = null">
            <ChildContent>
                @if (!string.IsNullOrWhiteSpace(_erroModalEditarAssoc))
                {
                    <div class="pc-alert pc-alert-danger">@_erroModalEditarAssoc</div>
                }
                <div class="pc-form-grid">
                    @RenderCamposPessoa(_formEditarAssoc, cpfSomenteLeitura: true)
                </div>
            </ChildContent>
            <FooterContent>
                <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _associadoEditarDados = null">Cancelar</button>
                <button type="button" class="pc-btn pc-btn-primary" @onclick="SalvarEdicaoAssociadoAsync">Salvar Alterações</button>
            </FooterContent>
        </PcModal>
    }

    @if (_associadoDependentes is not null)
    {
        <PcModal IsOpen="true"
                 Title="@($"Dependentes de {_associadoDependentes.NomeCompleto}")"
                 Subtitle="Cônjuge ou Filho(a) até 21 anos, inclusive"
                 MaxWidth="960px"
                 OnClose="() => { _associadoDependentes = null; _exibirModalNovoDependente = false; _dependenteEditar = null; }">
            <ChildContent>
                @if (!string.IsNullOrWhiteSpace(_erroDependentes))
                {
                    <div class="pc-alert pc-alert-danger">@_erroDependentes</div>
                }

                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 10px;">
                    <h4 style="margin: 0;">Dependentes Vinculados</h4>
                    @if (_associadoDependentes.Status == StatusAssociado.Ativo)
                    {
                        <button type="button" class="pc-btn pc-btn-primary pc-btn-sm" @onclick="AbrirModalNovoDependente">+ Cadastrar Dependente</button>
                    }
                </div>

                <div class="pc-table-wrap">
                    <table class="pc-table">
                        <thead>
                            <tr>
                                <th>Nome / Profissão</th>
                                <th>CPF</th>
                                <th>Vínculo</th>
                                <th>Nascimento</th>
                                <th>Auditoria</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_associadoDependentes.Dependentes.Count == 0)
                            {
                                <tr><td colspan="7">Nenhum dependente registrado.</td></tr>
                            }
                            @foreach (var d in _associadoDependentes.Dependentes)
                            {
                                <tr>
                                    <td>
                                        <strong>@d.NomeCompleto</strong>
                                        <div><small style="color: var(--pc-text-secondary);">@(string.IsNullOrWhiteSpace(d.Profissao) ? "Profissão não informada" : d.Profissao)</small></div>
                                        <div><small style="color: var(--pc-text-muted);">@d.Email — @d.Fone</small></div>
                                    </td>
                                    <td>@d.CpfMascarado</td>
                                    <td>@d.TipoVinculo</td>
                                    <td>@d.DataNascimento.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <small style="color: var(--pc-text-secondary); display: block;">Cadastro: @(d.CriadoEm?.ToString("dd/MM/yyyy HH:mm") ?? d.DataInicio.ToString("dd/MM/yyyy"))</small>
                                        <small style="color: var(--pc-text-secondary); display: block;">Última alt.: @(d.AtualizadoEm?.ToString("dd/MM/yyyy HH:mm") ?? "-")</small>
                                        <small style="color: var(--pc-text-muted);">Por: @(d.UltimaAlteracaoPorNome ?? "Sistema / Cadastro inicial")</small>
                                    </td>
                                    <td>
                                        @if (d.PendenteAprovacao)
                                        {
                                            <PcStatusBadge Text="Pendente de Aprovação" Variant="pendente" />
                                        }
                                        else
                                        {
                                            <PcStatusBadge Text="@(d.Ativo ? "Ativo" : $"Encerrado ({d.MotivoFim})")" Variant="@(d.Ativo ? "ativo" : "neutral")" />
                                        }
                                    </td>
                                    <td>
                                        <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                            <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="() => AbrirModalEditarDependente(d)">Editar Dados</button>
                                            @if (d.PendenteAprovacao)
                                            {
                                                <small style="color: var(--pc-text-muted); align-self: center;">Aguardando aprovação</small>
                                            }
                                            else if (d.Ativo)
                                            {
                                                <button type="button" class="pc-btn pc-btn-danger pc-btn-sm" @onclick="() => AlterarStatusDependenteAsync(d, false)">Desativar</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="() => AlterarStatusDependenteAsync(d, true)">Reativar</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
            <FooterContent>
                <button type="button" class="pc-btn pc-btn-outline" @onclick="() => { _associadoDependentes = null; _exibirModalNovoDependente = false; _dependenteEditar = null; }">Fechar</button>
            </FooterContent>
        </PcModal>

        <PcModal IsOpen="_exibirModalNovoDependente"
                 Title="@($"Cadastrar Dependente — Titular: {_associadoDependentes.NomeCompleto}")"
                 Subtitle="Campos obrigatórios padronizados com o cadastro de associados"
                 MaxWidth="820px"
                 OnClose="() => _exibirModalNovoDependente = false">
            <ChildContent>
                @if (!string.IsNullOrWhiteSpace(_erroModalDependente))
                {
                    <div class="pc-alert pc-alert-danger">@_erroModalDependente</div>
                }
                <div class="pc-form-grid">
                    @RenderCamposPessoa(_formNovoDep, cpfSomenteLeitura: false)
                    <div class="pc-field">
                        <label class="pc-label">Tipo de Vínculo *</label>
                        <select class="pc-select" @bind="_depVinculo">
                            <option value="@TipoVinculoDependente.Conjuge">Cônjuge</option>
                            <option value="@TipoVinculoDependente.Filho">Filho(a) (até 21 anos)</option>
                        </select>
                    </div>
                    <div class="pc-field"><label class="pc-label">Senha (para login próprio opcional)</label><input type="password" class="pc-input" @bind="_depSenha" /></div>
                </div>
            </ChildContent>
            <FooterContent>
                <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _exibirModalNovoDependente = false">Cancelar</button>
                <button type="button" class="pc-btn pc-btn-primary" @onclick="CadastrarDependenteAsync">Salvar Dependente</button>
            </FooterContent>
        </PcModal>

        <PcModal IsOpen="@(_dependenteEditar is not null)"
                 Title="@($"Editar Dependente — {_dependenteEditar?.NomeCompleto}")"
                 Subtitle="Atualize os dados do dependente (CPF não pode ser alterado)"
                 MaxWidth="820px"
                 OnClose="() => _dependenteEditar = null">
            <ChildContent>
                @if (!string.IsNullOrWhiteSpace(_erroModalEditarDep))
                {
                    <div class="pc-alert pc-alert-danger">@_erroModalEditarDep</div>
                }
                <div class="pc-form-grid">
                    @RenderCamposPessoa(_formEditarDep, cpfSomenteLeitura: true)
                    <div class="pc-field">
                        <label class="pc-label">Tipo de Vínculo *</label>
                        <select class="pc-select" @bind="_depVinculoEditar">
                            <option value="@TipoVinculoDependente.Conjuge">Cônjuge</option>
                            <option value="@TipoVinculoDependente.Filho">Filho(a) (até 21 anos)</option>
                        </select>
                    </div>
                </div>
            </ChildContent>
            <FooterContent>
                <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _dependenteEditar = null">Cancelar</button>
                <button type="button" class="pc-btn pc-btn-primary" @onclick="SalvarEdicaoDependenteAsync">Salvar Alterações</button>
            </FooterContent>
        </PcModal>
    }
}

@code {
    private sealed class DadosPessoaForm
    {
