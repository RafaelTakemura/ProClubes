        <div class="pc-field">
            <label class="pc-label">Cidade</label>
            <select class="pc-select" value="@form.Cidade" @onchange="e => SelecionarCidade(form, e.Value?.ToString())">
                <option value="">-- Selecione --</option>
                @foreach (var cid in ObterCidadesDisponiveis(form.UF, form.Cidade))
                {
                    <option value="@cid.Nome">@cid.Nome (@cid.EstadoUF)</option>
                }
            </select>
        </div>
    </text>;

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += HandleContextChanged;
        _unidadeIdNovo = Session.UnidadeContextoId ?? Session.Usuario?.UnidadeAdministrativaId ?? 1;
        await CarregarUnidadesAsync();
        await CarregarLocalidadesAsync();
        await CarregarAsync();
    }

    private async void HandleContextChanged()
    {
        if (Session.UnidadeContextoId.HasValue)
            _unidadeIdNovo = Session.UnidadeContextoId.Value;
        await CarregarAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CarregarUnidadesAsync()
    {
        var (data, _) = await Api.GetAsync<IReadOnlyList<UnidadeDto>>("api/v1/unidades");
        if (data is not null && data.Count > 0)
        {
            _unidades = data;
            if (!_unidades.Any(u => u.Id == _unidadeIdNovo))
                _unidadeIdNovo = _unidades[0].Id;
        }
    }

    private async Task CarregarLocalidadesAsync()
    {
        var (estados, _) = await Api.GetAsync<IReadOnlyList<EstadoDto>>("api/v1/localidades/estados?apenasAtivos=true");
        var (cidades, _) = await Api.GetAsync<IReadOnlyList<CidadeDto>>("api/v1/localidades/cidades?apenasAtivas=true");
        if (estados is not null) _estados = estados;
        if (cidades is not null) _cidades = cidades;
    }

    private async Task CarregarAsync()
    {
        _erro = null;
        var q = new List<string> { "page=1", "pageSize=50" };
        if (Session.UnidadeContextoId.HasValue) q.Add($"unidadeId={Session.UnidadeContextoId.Value}");
        if (!string.IsNullOrWhiteSpace(_filtroCategoria)) q.Add($"codigoCategoria={_filtroCategoria}");
        if (!string.IsNullOrWhiteSpace(_filtroStatus)) q.Add($"status={_filtroStatus}");
        if (!string.IsNullOrWhiteSpace(_busca)) q.Add($"busca={Uri.EscapeDataString(_busca)}");

        var (data, err) = await Api.GetAsync<PagedResponse<AssociadoDto>>($"api/v1/admin/associados?{string.Join("&", q)}");
        if (data is not null) _associados = data.Items;
        _erro = err;
    }

    private IReadOnlyList<EstadoDto> ObterEstadosDisponiveis(string? cidadeSelecionada, string? ufAtual)
    {
        List<EstadoDto> lista;
        if (!string.IsNullOrWhiteSpace(cidadeSelecionada))
        {
            var ufsDaCidade = _cidades
                .Where(c => string.Equals(c.Nome, cidadeSelecionada.Trim(), StringComparison.OrdinalIgnoreCase))
                .Select(c => c.EstadoUF)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            lista = ufsDaCidade.Count > 0
                ? _estados.Where(e => ufsDaCidade.Contains(e.UF)).ToList()
                : _estados.ToList();
        }
        else
        {
            lista = _estados.ToList();
        }

        if (!string.IsNullOrWhiteSpace(ufAtual) && !lista.Any(e => string.Equals(e.UF, ufAtual.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            var estExistente = _estados.FirstOrDefault(e => string.Equals(e.UF, ufAtual.Trim(), StringComparison.OrdinalIgnoreCase));
            lista.Add(estExistente ?? new EstadoDto(0, ufAtual.Trim().ToUpperInvariant(), ufAtual.Trim().ToUpperInvariant(), true, 0, DateTimeOffset.MinValue, DateTimeOffset.MinValue));
        }

        return lista;
    }

    private IReadOnlyList<CidadeDto> ObterCidadesDisponiveis(string? ufSelecionada, string? cidadeAtual)
    {
        var lista = string.IsNullOrWhiteSpace(ufSelecionada)
            ? _cidades.ToList()
            : _cidades.Where(c => string.Equals(c.EstadoUF, ufSelecionada.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

        if (!string.IsNullOrWhiteSpace(cidadeAtual) && !lista.Any(c => string.Equals(c.Nome, cidadeAtual.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            var ufLabel = string.IsNullOrWhiteSpace(ufSelecionada) ? "--" : ufSelecionada.Trim().ToUpperInvariant();
            lista.Add(new CidadeDto(0, cidadeAtual.Trim(), 0, ufLabel, ufLabel, true, DateTimeOffset.MinValue, DateTimeOffset.MinValue));
        }

        return lista;
    }

    private void SelecionarEstado(DadosPessoaForm form, string? novaUf)
    {
        var ufNorm = (novaUf ?? string.Empty).Trim().ToUpperInvariant();
        form.UF = ufNorm;

        if (!string.IsNullOrWhiteSpace(ufNorm) && !string.IsNullOrWhiteSpace(form.Cidade))
        {
            var pertence = _cidades.Any(c =>
                string.Equals(c.Nome, form.Cidade.Trim(), StringComparison.OrdinalIgnoreCase)
                && string.Equals(c.EstadoUF, ufNorm, StringComparison.OrdinalIgnoreCase));
            if (!pertence)
                form.Cidade = string.Empty;
        }
    }

    private void SelecionarCidade(DadosPessoaForm form, string? novaCidade)
    {
        var cidNorm = (novaCidade ?? string.Empty).Trim();
        form.Cidade = cidNorm;

        if (string.IsNullOrWhiteSpace(cidNorm))
            return;

        var ufsCorrespondentes = _cidades
            .Where(c => string.Equals(c.Nome, cidNorm, StringComparison.OrdinalIgnoreCase))
            .Select(c => c.EstadoUF)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (ufsCorrespondentes.Count == 1)
        {
            form.UF = ufsCorrespondentes[0];
        }
        else if (ufsCorrespondentes.Count > 1 && !ufsCorrespondentes.Contains(form.UF, StringComparer.OrdinalIgnoreCase))
        {
            form.UF = string.Empty;
        }
    }

    private void AbrirModalGerenciar(AssociadoDto a)
    {
        _erroModalGerenciar = null;
        _associadoDependentes = null;
        _associadoGerenciar = a;
        _novaCategoriaSel = a.CategoriaCodigo;
        _novaRoleSel = a.RoleAdministrativa == RoleAdministrativa.SuperAdmin
            ? RoleAdministrativa.Nenhuma
            : a.RoleAdministrativa;
        var outraUnidade = _unidades.FirstOrDefault(u => u.Id != a.UnidadeId);
        if (outraUnidade is not null)
            _unidadeDestinoTransf = outraUnidade.Id;
    }

