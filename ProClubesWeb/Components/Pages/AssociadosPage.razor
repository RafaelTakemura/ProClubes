    private async Task AbrirModalNovoAssociado()
    {
        await CarregarLocalidadesAsync();
        _erroModalNovo = null;
        _formNovoAssoc.Reset();
        _senhaNovo = string.Empty;
        _categoriaNovo = "ASSOCIADO";
        _roleInicialNovo = RoleAdministrativa.Nenhuma;
        _unidadeIdNovo = Session.UnidadeContextoId ?? Session.Usuario?.UnidadeAdministrativaId ?? (_unidades.FirstOrDefault()?.Id ?? 1);
        _exibirNovoAssociado = true;
    }

    private static string? ValidarFormularioPessoa(DadosPessoaForm form, bool validarCpf)
    {
        if (string.IsNullOrWhiteSpace(form.Nome)
            || (validarCpf && string.IsNullOrWhiteSpace(form.Cpf))
            || string.IsNullOrWhiteSpace(form.Sexo)
            || string.IsNullOrWhiteSpace(form.EstadoCivil)
            || !form.Nascimento.HasValue
            || string.IsNullOrWhiteSpace(form.Profissao)
            || string.IsNullOrWhiteSpace(form.Fone)
            || string.IsNullOrWhiteSpace(form.Email))
        {
            return "Preencha todos os campos obrigatórios (*) antes de salvar.";
        }

        if (!string.IsNullOrWhiteSpace(form.UF) && form.UF.Trim().Length != 2)
            return "Quando informada, a UF deve conter exatamente 2 letras (ex.: PR, SP).";

        if (validarCpf && !ValidarSintaxeCpf(form.Cpf))
            return "Sintaxe de CPF inválida. Informe 11 dígitos numéricos ou no formato 000.000.000-00.";

        if (!ValidarSintaxeTelefone(form.Fone))
            return "Sintaxe de telefone inválida. Informe DDD + número (10 ou 11 dígitos, ex.: (45) 99999-1111 ou 45999991111).";

        if (!ValidarSintaxeEmail(form.Email))
            return "Sintaxe de e-mail inválida. Informe um endereço no formato usuario@dominio.com.";

        return null;
    }

    private async Task CriarAssociadoAsync()
    {
        _erro = _mensagem = _erroModalNovo = null;

        var erroForm = ValidarFormularioPessoa(_formNovoAssoc, validarCpf: true);
        if (erroForm is not null || string.IsNullOrWhiteSpace(_senhaNovo))
        {
            _erroModalNovo = erroForm ?? "Informe a senha inicial obrigatória (*).";
            return;
        }

        var roleInicial = Session.IsSuperAdmin ? _roleInicialNovo : RoleAdministrativa.Nenhuma;
        var req = new CriarAssociadoAdminRequest(
            _formNovoAssoc.Nome, _formNovoAssoc.Cpf, _formNovoAssoc.Sexo, _formNovoAssoc.EstadoCivil, _formNovoAssoc.Nascimento!.Value,
