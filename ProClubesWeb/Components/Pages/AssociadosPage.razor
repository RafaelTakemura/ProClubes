            Nome = Cpf = CpfSomenteLeitura = Sexo = EstadoCivil = Profissao = Fone = Email = Logradouro = Numero = Bairro = Cidade = UF = string.Empty;
            Nascimento = null;
        }
    }

    private IReadOnlyList<AssociadoDto> _associados = Array.Empty<AssociadoDto>();
