@page "/espacos"
@implements IDisposable
@inject ProClubesApiClient Api
@inject WebSessionState Session

<PageTitle>Espaços e Reservas — ProClubesWeb</PageTitle>

<div class="pc-page-header">
    <div class="pc-header-titles">
        <span class="pc-badge-eyebrow">ProClubes Enterprise • Operações &amp; Infraestrutura</span>
        <h1 class="pc-title">Espaços, Agenda e Reservas</h1>
        <p class="pc-subtitle">Gestão de espaços por hora ou por dia, valores de reserva, galeria de fotos e agenda compartilhada com eventos.</p>
    </div>
    <div class="pc-header-actions">
        <button type="button" class="pc-btn pc-btn-primary" @onclick="AbrirNovoEspaco">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Novo Espaço
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_mensagem))
{
    <div class="pc-alert pc-alert-success" role="status">@_mensagem</div>
}
@if (!string.IsNullOrWhiteSpace(_erro))
{
    <div class="pc-alert pc-alert-danger" role="alert">@_erro</div>
}

<PcModal IsOpen="_exibirFormEspaco"
         Title="@(_espacoEditandoId.HasValue ? "Editar Espaço Físico" : "Cadastrar Espaço Físico")"
         Subtitle="Configure tipo de locação (por hora ou por dia), valor de reserva e horário de funcionamento"
         MaxWidth="720px"
         OnClose="() => _exibirFormEspaco = false">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_erroModalEspaco))
        {
            <div class="pc-alert pc-alert-danger">@_erroModalEspaco</div>
        }
        <div class="pc-form-grid">
            <div class="pc-field">
                <label class="pc-label">Unidade *</label>
                <select class="pc-select" disabled="@(!Session.IsSuperAdmin)" @bind="_unidIdEspaco">
                    @foreach (var u in _unidades)
                    {
                        <option value="@u.Id">@u.Nome (@u.Sigla)</option>
                    }
                </select>
            </div>
            <div class="pc-field"><label class="pc-label">Nome do Espaço *</label><input class="pc-input" @bind="_nomeEspaco" /></div>
            <div class="pc-field" style="grid-column: 1 / -1;"><label class="pc-label">Descrição</label><input class="pc-input" @bind="_descEspaco" /></div>
            <div class="pc-field">
                <label class="pc-label">Tipo de Locação *</label>
                <select class="pc-select" @bind="_tipoLocacaoEspaco">
                    <option value="@TipoLocacaoEspaco.PorHora">Por Horário (ex.: quadras, quiosques)</option>
                    <option value="@TipoLocacaoEspaco.PorDia">Por Dia / Diárias (ex.: salões de festa)</option>
                </select>
            </div>
            <div class="pc-field">
                <label class="pc-label">@(_tipoLocacaoEspaco == TipoLocacaoEspaco.PorDia ? "Valor da Reserva por Dia (R$) *" : "Valor da Reserva por Hora (R$) *")</label>
                <input type="number" step="0.01" min="0" class="pc-input" @bind="_valorReservaEspaco" />
            </div>
            <div class="pc-field">
                <label class="pc-label">Horário de Abertura *</label>
                <input type="time" class="pc-input" @bind="_horaAbertura" />
            </div>
            <div class="pc-field">
                <label class="pc-label">Horário de Fechamento *</label>
                <input type="time" class="pc-input" @bind="_horaFechamento" />
            </div>
            @if (_tipoLocacaoEspaco == TipoLocacaoEspaco.PorHora)
            {
                <div class="pc-field"><label class="pc-label">Duração Máxima (minutos) *</label><input type="number" min="60" class="pc-input" @bind="_duracaoMaxMin" /></div>
            }
            <div class="pc-field"><label class="pc-label">Antecedência Máxima (dias) *</label><input type="number" min="1" class="pc-input" @bind="_antecedenciaMaxDias" /></div>
            @if (_espacoEditandoId.HasValue)
            {
                <div class="pc-field">
                    <label class="pc-label">Situação</label>
                    <select class="pc-select" @bind="_espacoAtivoStr">
                        <option value="true">Ativo</option>
                        <option value="false">Inativo</option>
                    </select>
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _exibirFormEspaco = false">Cancelar</button>
        <button type="button" class="pc-btn pc-btn-primary" @onclick="SalvarEspacoAsync">Salvar Espaço</button>
    </FooterContent>
</PcModal>

<div class="pc-card" style="margin-bottom: 20px;">
    <h3 style="margin-top: 0; font-size: 18px;">Espaços da Unidade</h3>
    <div class="pc-table-wrap">
        <table class="pc-table">
            <thead>
                <tr>
                    <th>Foto</th>
                    <th>ID / Nome</th>
                    <th>Unidade</th>
                    <th>Locação / Valor</th>
                    <th>Funcionamento</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (_espacos.Count == 0)
                {
                    <tr><td colspan="7">Nenhum espaço cadastrado.</td></tr>
                }
                @foreach (var e in _espacos)
                {
                    var fotos = e.Fotos ?? Array.Empty<FotoItemDto>();
                    <tr>
                        <td>
                            @if (fotos.Count > 0)
                            {
                                <img src="@Api.ResolveMediaUrl(fotos[0].UrlRelativa)"
                                     alt="@e.Nome"
                                     style="width: 56px; height: 42px; object-fit: cover; border-radius: 8px; border: 1px solid var(--pc-border);" />
                            }
                            else
                            {
                                <small style="color: var(--pc-text-muted);">Sem foto</small>
                            }
                        </td>
                        <td><strong>#@e.Id — @e.Nome</strong><br /><small style="color: var(--pc-text-secondary);">@e.Descricao</small></td>
                        <td>@e.UnidadeNome</td>
                        <td>
                            <PcStatusBadge Text="@WebFormatHelpers.ObterRotuloTipoLocacao(e.TipoLocacao)" Variant="info" />
                            <div style="margin-top: 4px;">
                                <strong>R$ @e.ValorReserva.ToString("N2")</strong><small style="color: var(--pc-text-muted);">@WebFormatHelpers.ObterSufixoValorLocacao(e.TipoLocacao)</small>
                            </div>
                        </td>
                        <td>
                            @e.HoraAbertura.ToString("HH:mm") às @e.HoraFechamento.ToString("HH:mm")
                            <div><small style="color: var(--pc-text-muted);">@(e.TipoLocacao == TipoLocacaoEspaco.PorHora ? $"Máx. {e.DuracaoMaximaMinutos} min • " : "")Até @e.AntecedenciaMaximaDias dias</small></div>
                        </td>
                        <td><PcStatusBadge Text="@(e.Ativo ? "Ativo" : "Inativo")" Variant="@(e.Ativo ? "ativo" : "inativo")" /></td>
                        <td>
                            <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="() => AbrirEditarEspaco(e)">Editar</button>
                                <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="() => AbrirModalFotosEspaco(e)">Fotos (@fotos.Count)</button>
                                <button type="button" class="pc-btn pc-btn-primary pc-btn-sm" @onclick="() => AbrirAgendaEspacoAsync(e)">Agenda / Bloqueios</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<PcModal IsOpen="@(_espacoFotos is not null)"
         Title="@($"Fotos do Espaço — {_espacoFotos?.Nome}")"
         Subtitle="Adicione imagens (JPG, PNG ou WEBP até 5 MB) exibidas no sistema web e no aplicativo"
         MaxWidth="780px"
         OnClose="() => _espacoFotos = null">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_erroModalFotos))
        {
            <div class="pc-alert pc-alert-danger">@_erroModalFotos</div>
        }
        <div class="pc-field" style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 14px;">
            <label class="pc-label">Enviar nova foto do espaço</label>
            <InputFile OnChange="OnUploadFotoEspacoAsync" accept=".jpg,.jpeg,.png,.webp" class="pc-input" />
            <small style="color: var(--pc-text-muted);">Selecione um arquivo de imagem para enviar automaticamente.</small>
        </div>

        @{
            var listaFotosEspaco = _espacoFotos?.Fotos ?? Array.Empty<FotoItemDto>();
        }
        @if (listaFotosEspaco.Count == 0)
        {
            <p style="color: var(--pc-text-muted);">Nenhuma foto cadastrada para este espaço.</p>
        }
        else
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px;">
                @foreach (var f in listaFotosEspaco)
                {
                    <div style="border: 1px solid var(--pc-border); border-radius: 10px; padding: 8px; background: var(--pc-bg);">
                        <img src="@Api.ResolveMediaUrl(f.UrlRelativa)"
                             alt="@f.NomeArquivo"
                             style="width: 100%; height: 120px; object-fit: cover; border-radius: 6px; margin-bottom: 6px;" />
                        <div style="font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 6px;" title="@f.NomeArquivo">@f.NomeArquivo</div>
                        <button type="button" class="pc-btn pc-btn-danger pc-btn-sm" style="width: 100%;" @onclick="() => RemoverFotoEspacoAsync(f.Id)">Excluir</button>
                    </div>
                }
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _espacoFotos = null">Fechar</button>
    </FooterContent>
</PcModal>

<PcModal IsOpen="@(_espacoAgenda is not null)"
         Title="@($"Agenda de Ocupações — {_espacoAgenda?.Nome}")"
         Subtitle="@($"{_espacoAgenda?.UnidadeNome} | {WebFormatHelpers.ObterRotuloTipoLocacao(_espacoAgenda?.TipoLocacao ?? TipoLocacaoEspaco.PorHora)} (R$ {_espacoAgenda?.ValorReserva:N2}{WebFormatHelpers.ObterSufixoValorLocacao(_espacoAgenda?.TipoLocacao ?? TipoLocacaoEspaco.PorHora)})")"
         MaxWidth="880px"
         OnClose="() => _espacoAgenda = null">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_erroModalAgenda))
        {
            <div class="pc-alert pc-alert-danger">@_erroModalAgenda</div>
        }

        <div style="display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap; margin-bottom: 16px;">
            <div class="pc-field" style="margin-bottom: 0;">
                <label class="pc-label">@(_espacoAgenda?.TipoLocacao == TipoLocacaoEspaco.PorDia ? "Data Inicial da Consulta" : "Dia da Agenda")</label>
                <input type="date" class="pc-input" @bind="_agendaDataInicio" />
            </div>
            @if (_espacoAgenda?.TipoLocacao == TipoLocacaoEspaco.PorDia)
            {
                <div class="pc-field" style="margin-bottom: 0;">
                    <label class="pc-label">Data Final da Consulta</label>
                    <input type="date" class="pc-input" @bind="_agendaDataFim" />
                </div>
            }
            <button type="button" class="pc-btn pc-btn-outline" @onclick="AtualizarAgendaAtualAsync">Consultar Agenda</button>
        </div>

        @if (_agendaAtual is not null)
        {
            <h4 style="margin: 0 0 10px;">
                @(_agendaAtual.TipoLocacao == TipoLocacaoEspaco.PorDia ? "Disponibilidade por Dia" : $"Grade de Horários ({_agendaAtual.DataInicioConsulta:dd/MM/yyyy})")
            </h4>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 8px; margin-bottom: 18px;">
                @foreach (var slot in _agendaAtual.Slots)
                {
                    <div style="border: 1px solid @(slot.Disponivel ? "#BBF7D0" : "#FECACA"); background: @(slot.Disponivel ? "#F0FDF4" : "#FEF2F2"); border-radius: 8px; padding: 8px 10px;">
                        <div style="font-weight: 700; font-size: 13px;">@slot.Rotulo</div>
                        @if (slot.Disponivel)
                        {
                            <small style="color: #15803D; font-weight: 600;">Livre</small>
                        }
                        else
                        {
                            <small style="color: #B91C1C; font-weight: 600; display: block;">@slot.OrigemOcupacao</small>
                            <small style="color: var(--pc-text-secondary);">@slot.DescricaoOcupacao</small>
                        }
                    </div>
                }
            </div>
        }

        <div style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 14px; margin-bottom: 16px;">
            <h4 style="margin-top: 0; margin-bottom: 10px;">Registrar Bloqueio de Manutenção</h4>
            <div class="pc-form-grid">
                <div class="pc-field" style="grid-column: 1 / -1;">
                    <label class="pc-label">Descrição do Bloqueio *</label>
                    <input class="pc-input" @bind="_descManutencao" placeholder="Ex.: Pintura, reforma ou manutenção preventiva" />
                </div>
                <div class="pc-field">
                    <label class="pc-label">Data Início *</label>
                    <input type="date" class="pc-input" @bind="_manutDataIni" />
                </div>
                <div class="pc-field">
                    <label class="pc-label">Data Fim *</label>
                    <input type="date" class="pc-input" @bind="_manutDataFim" />
                </div>
                @if (_espacoAgenda?.TipoLocacao == TipoLocacaoEspaco.PorHora)
                {
                    <div class="pc-field">
                        <label class="pc-label">Hora Início *</label>
                        <input type="time" class="pc-input" @bind="_manutHoraIni" />
                    </div>
                    <div class="pc-field">
                        <label class="pc-label">Hora Fim *</label>
                        <input type="time" class="pc-input" @bind="_manutHoraFim" />
                    </div>
                }
            </div>
            <button type="button" class="pc-btn pc-btn-secondary" @onclick="CriarBloqueioManutencaoAsync">Bloquear Período na Agenda</button>
        </div>

        <h4 style="margin: 0 0 8px;">Ocupações Ativas no Período (Reservas, Eventos e Manutenções)</h4>
        <div class="pc-table-wrap">
            <table class="pc-table">
                <thead>
                    <tr>
                        <th>Início</th>
                        <th>Fim</th>
                        <th>Natureza</th>
                        <th>Detalhe</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_agendaAtual is null || _agendaAtual.Ocupacoes.Count == 0)
                    {
                        <tr><td colspan="4">Espaço livre no período consultado.</td></tr>
                    }
                    else
                    {
                        @foreach (var o in _agendaAtual.Ocupacoes)
                        {
                            <tr>
                                <td>@o.Inicio.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@o.Fim.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <PcStatusBadge Text="@o.Origem.ToString()"
                                                   Variant="@(o.Origem == OrigemOcupacaoEspaco.Reserva ? "success" : (o.Origem == OrigemOcupacaoEspaco.Evento ? "info" : "warning"))" />
                                </td>
                                <td>@o.DescricaoPublica</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _espacoAgenda = null">Fechar Agenda</button>
    </FooterContent>
</PcModal>

<div class="pc-card">
    <h3 style="margin-top: 0; font-size: 18px;">Reservas de Associados</h3>
    <div class="pc-table-wrap">
        <table class="pc-table">
            <thead>
                <tr>
                    <th>Reserva</th>
                    <th>Espaço / Unidade</th>
                    <th>Associado Titular</th>
                    <th>Período Reservado</th>
                    <th>Valor</th>
                    <th>Status</th>
                    <th>Ação Administrativa</th>
                </tr>
            </thead>
            <tbody>
                @if (_reservas.Count == 0)
                {
                    <tr><td colspan="7">Nenhuma reserva encontrada.</td></tr>
                }
                @foreach (var r in _reservas)
                {
                    <tr>
                        <td>#@r.Id</td>
                        <td>
                            <strong>@r.EspacoNome</strong><br />
                            <small>@r.UnidadeNome • @WebFormatHelpers.ObterRotuloTipoLocacao(r.TipoLocacao)</small>
                        </td>
                        <td>@r.AssociadoNome</td>
                        <td>@WebFormatHelpers.FormatarPeriodoPorTipo(r.TipoLocacao, r.Inicio, r.Fim)</td>
                        <td><strong>R$ @r.ValorTotal.ToString("N2")</strong></td>
                        <td>
                            <PcStatusBadge Text="@r.Status.ToString()" Variant="@r.Status.ToString()" />
                            @if (!string.IsNullOrWhiteSpace(r.JustificativaCancelamento))
                            {
                                <div><small style="color: var(--pc-danger);">Justificativa: @r.JustificativaCancelamento</small></div>
                            }
                        </td>
                        <td>
                            @if (r.Status == StatusReserva.Confirmada)
                            {
                                <button type="button" class="pc-btn pc-btn-danger pc-btn-sm" @onclick="() => AbrirModalCancelarReserva(r)">Cancelar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<PcModal IsOpen="@(_reservaParaCancelar is not null)"
         Title="@($"Cancelar Reserva #{_reservaParaCancelar?.Id}")"
         Subtitle="@($"{_reservaParaCancelar?.EspacoNome} — Associado: {_reservaParaCancelar?.AssociadoNome} ({_reservaParaCancelar?.Inicio:dd/MM/yyyy HH\\:mm})")"
         MaxWidth="540px"
         OnClose="() => _reservaParaCancelar = null">
    <ChildContent>
        <div class="pc-field">
            <label class="pc-label">Justificativa do Cancelamento Administrativo (obrigatória) *</label>
            <textarea class="pc-textarea" rows="3" placeholder="Informe o motivo do cancelamento (será enviado como notificação interna ao associado)..." @bind="_justificativaCancelamento"></textarea>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _reservaParaCancelar = null">Voltar</button>
        <button type="button" class="pc-btn pc-btn-danger" @onclick="ConfirmarCancelamentoReservaAdminAsync">Confirmar Cancelamento</button>
    </FooterContent>
</PcModal>

@code {
    private IReadOnlyList<UnidadeDto> _unidades = Array.Empty<UnidadeDto>();
    private IReadOnlyList<EspacoDto> _espacos = Array.Empty<EspacoDto>();
    private IReadOnlyList<ReservaEspacoDto> _reservas = Array.Empty<ReservaEspacoDto>();

    private EspacoDto? _espacoAgenda;
    private AgendaEspacoDto? _agendaAtual;
    private DateOnly _agendaDataInicio = DateOnly.FromDateTime(DateTime.Now);
    private DateOnly _agendaDataFim = DateOnly.FromDateTime(DateTime.Now.AddDays(14));
    private DateOnly _manutDataIni = DateOnly.FromDateTime(DateTime.Now.AddDays(1));
    private DateOnly _manutDataFim = DateOnly.FromDateTime(DateTime.Now.AddDays(1));
    private TimeOnly _manutHoraIni = new(14, 0);
    private TimeOnly _manutHoraFim = new(16, 0);
    private string _descManutencao = "Manutenção preventiva";
    private string? _erroModalAgenda;

    private EspacoDto? _espacoFotos;
    private string? _erroModalFotos;

    private ReservaEspacoDto? _reservaParaCancelar;
    private string _justificativaCancelamento = string.Empty;

    private bool _exibirFormEspaco;
    private int? _espacoEditandoId;
    private int _unidIdEspaco = 1;
    private string _nomeEspaco = string.Empty;
    private string _descEspaco = string.Empty;
    private TipoLocacaoEspaco _tipoLocacaoEspaco = TipoLocacaoEspaco.PorHora;
    private decimal _valorReservaEspaco = 100m;
    private TimeOnly _horaAbertura = new(8, 0);
    private TimeOnly _horaFechamento = new(22, 0);
    private int _duracaoMaxMin = 240;
    private int _antecedenciaMaxDias = 90;
    private string _espacoAtivoStr = "true";
    private string? _erroModalEspaco;

    private string? _erro;
    private string? _mensagem;

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += HandleContextChanged;
        _unidIdEspaco = Session.UnidadeContextoId ?? Session.Usuario?.UnidadeAdministrativaId ?? 1;
        await CarregarAsync();
    }

    private async void HandleContextChanged()
    {
        if (Session.UnidadeContextoId.HasValue) _unidIdEspaco = Session.UnidadeContextoId.Value;
        await CarregarAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CarregarAsync()
    {
        _erro = null;
        var (unids, _) = await Api.GetAsync<IReadOnlyList<UnidadeDto>>("api/v1/unidades");
        if (unids is not null) _unidades = unids;

        var q = Session.UnidadeContextoId.HasValue ? $"?unidadeId={Session.UnidadeContextoId.Value}" : "";
        var (esp, err1) = await Api.GetAsync<IReadOnlyList<EspacoDto>>($"api/v1/espacos{q}");
        if (esp is not null)
        {
            _espacos = esp;
            if (_espacoFotos is not null)
                _espacoFotos = _espacos.FirstOrDefault(x => x.Id == _espacoFotos.Id);
        }

        var (res, err2) = await Api.GetAsync<IReadOnlyList<ReservaEspacoDto>>($"api/v1/reservas{q}");
        if (res is not null) _reservas = res;

        _erro = err1 ?? err2;
    }

    private void AbrirNovoEspaco()
    {
        _erroModalEspaco = null;
        _espacoEditandoId = null;
        _unidIdEspaco = Session.UnidadeContextoId ?? Session.Usuario?.UnidadeAdministrativaId ?? (_unidades.FirstOrDefault()?.Id ?? 1);
        _nomeEspaco = string.Empty;
        _descEspaco = string.Empty;
        _tipoLocacaoEspaco = TipoLocacaoEspaco.PorHora;
        _valorReservaEspaco = 100m;
        _horaAbertura = new TimeOnly(8, 0);
        _horaFechamento = new TimeOnly(22, 0);
        _duracaoMaxMin = 240;
        _antecedenciaMaxDias = 90;
        _espacoAtivoStr = "true";
        _exibirFormEspaco = true;
    }

    private void AbrirEditarEspaco(EspacoDto e)
    {
        _erroModalEspaco = null;
        _espacoEditandoId = e.Id;
        _unidIdEspaco = e.UnidadeId;
        _nomeEspaco = e.Nome;
        _descEspaco = e.Descricao ?? string.Empty;
        _tipoLocacaoEspaco = e.TipoLocacao;
        _valorReservaEspaco = e.ValorReserva;
        _horaAbertura = e.HoraAbertura;
        _horaFechamento = e.HoraFechamento;
        _duracaoMaxMin = e.DuracaoMaximaMinutos;
        _antecedenciaMaxDias = e.AntecedenciaMaximaDias;
        _espacoAtivoStr = e.Ativo ? "true" : "false";
        _exibirFormEspaco = true;
    }

    private async Task SalvarEspacoAsync()
    {
        _erroModalEspaco = _mensagem = null;
        var req = new CriarOuAtualizarEspacoRequest(
            _unidIdEspaco,
            _nomeEspaco,
            _descEspaco,
            _espacoEditandoId.HasValue ? _espacoAtivoStr == "true" : true,
            _horaAbertura,
            _horaFechamento,
            _tipoLocacaoEspaco == TipoLocacaoEspaco.PorDia ? 1440 : _duracaoMaxMin,
            _antecedenciaMaxDias,
            _tipoLocacaoEspaco,
            _valorReservaEspaco);

        var res = _espacoEditandoId.HasValue
            ? await Api.PutAsync<EspacoDto>($"api/v1/admin/espacos/{_espacoEditandoId.Value}", req)
            : await Api.PostAsync<EspacoDto>("api/v1/admin/espacos", req);

        if (res.Error is not null)
        {
            _erroModalEspaco = res.Error;
            return;
        }

        _exibirFormEspaco = false;
        _mensagem = _espacoEditandoId.HasValue ? "Espaço atualizado com sucesso." : "Espaço cadastrado com sucesso.";
        await CarregarAsync();
    }

    private void AbrirModalFotosEspaco(EspacoDto e)
    {
        _erroModalFotos = null;
        _espacoFotos = e;
    }

    private async Task OnUploadFotoEspacoAsync(InputFileChangeEventArgs args)
    {
        if (_espacoFotos is null) return;
        _erroModalFotos = _mensagem = null;

        var (uploadReq, fileErr) = await WebFormatHelpers.LerArquivoFotoAsync(args.File);
        if (fileErr is not null || uploadReq is null)
        {
            _erroModalFotos = fileErr;
            return;
        }

        var (_, apiErr) = await Api.PostAsync<FotoItemDto>($"api/v1/admin/espacos/{_espacoFotos.Id}/fotos", uploadReq);
        if (apiErr is not null)
        {
            _erroModalFotos = apiErr;
            return;
        }

        _mensagem = $"Foto '{uploadReq.NomeArquivo}' adicionada ao espaço.";
        await CarregarAsync();
    }

    private async Task RemoverFotoEspacoAsync(int fotoId)
    {
        if (_espacoFotos is null) return;
        _erroModalFotos = _mensagem = null;

        var err = await Api.DeleteAsync($"api/v1/admin/espacos/{_espacoFotos.Id}/fotos/{fotoId}");
        if (err is not null)
        {
            _erroModalFotos = err;
            return;
        }

        _mensagem = "Foto removida do espaço.";
        await CarregarAsync();
    }

    private async Task AbrirAgendaEspacoAsync(EspacoDto e)
    {
        _espacoAgenda = e;
        _erroModalAgenda = null;
        var hoje = DateOnly.FromDateTime(DateTime.Now);
        _agendaDataInicio = hoje;
        _agendaDataFim = e.TipoLocacao == TipoLocacaoEspaco.PorDia ? hoje.AddDays(14) : hoje;
        _manutDataIni = hoje.AddDays(1);
        _manutDataFim = hoje.AddDays(1);
        _manutHoraIni = new TimeOnly(14, 0);
        _manutHoraFim = new TimeOnly(16, 0);
        await AtualizarAgendaAtualAsync();
    }

    private async Task AtualizarAgendaAtualAsync()
    {
        if (_espacoAgenda is null) return;
        _erroModalAgenda = null;
        var url = $"api/v1/espacos/{_espacoAgenda.Id}/agenda?dataInicio={_agendaDataInicio:yyyy-MM-dd}&dataFim={_agendaDataFim:yyyy-MM-dd}";
        var (agenda, err) = await Api.GetAsync<AgendaEspacoDto>(url);
        if (agenda is not null) _agendaAtual = agenda;
        _erroModalAgenda = err;
    }

    private async Task CriarBloqueioManutencaoAsync()
    {
        if (_espacoAgenda is null) return;
        _erroModalAgenda = _mensagem = null;

        var offset = TimeSpan.FromHours(-3);
        DateTimeOffset ini;
        DateTimeOffset fim;

        if (_espacoAgenda.TipoLocacao == TipoLocacaoEspaco.PorDia)
        {
            ini = new DateTimeOffset(_manutDataIni.ToDateTime(TimeOnly.MinValue), offset);
            fim = new DateTimeOffset(_manutDataFim.ToDateTime(new TimeOnly(23, 59)), offset);
        }
        else
        {
            ini = new DateTimeOffset(_manutDataIni.ToDateTime(_manutHoraIni), offset);
            fim = new DateTimeOffset(_manutDataFim.ToDateTime(_manutHoraFim), offset);
        }

        var (_, err) = await Api.PostAsync<OcupacaoEspacoDto>(
            "api/v1/admin/espacos/bloqueios",
            new CriarBloqueioManutencaoRequest(_espacoAgenda.Id, ini, fim, _descManutencao));

        if (err is not null)
        {
            _erroModalAgenda = err;
            return;
        }

        _mensagem = "Bloqueio de manutenção registrado na agenda do espaço.";
        await AtualizarAgendaAtualAsync();
    }

    private void AbrirModalCancelarReserva(ReservaEspacoDto r)
    {
        _reservaParaCancelar = r;
        _justificativaCancelamento = string.Empty;
    }

    private async Task ConfirmarCancelamentoReservaAdminAsync()
    {
        if (_reservaParaCancelar is null) return;
        _erro = _mensagem = null;
        var reservaId = _reservaParaCancelar.Id;
        var (_, err) = await Api.PostAsync<ReservaEspacoDto>(
            $"api/v1/reservas/{reservaId}/cancelamento",
            new CancelarReservaRequest(_justificativaCancelamento));
        if (err is not null) { _erro = err; return; }
        _reservaParaCancelar = null;
        _justificativaCancelamento = string.Empty;
        _mensagem = $"Reserva #{reservaId} cancelada e notificação interna enviada ao associado.";
        await CarregarAsync();
    }

    public void Dispose()
    {
        Session.OnChange -= HandleContextChanged;
    }
