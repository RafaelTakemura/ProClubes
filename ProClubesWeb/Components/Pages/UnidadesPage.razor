@page "/unidades"
@inject ProClubesApiClient Api
@inject WebSessionState Session

<PageTitle>Unidades e Equipe — ProClubesWeb</PageTitle>

@if (!Session.IsSuperAdmin)
{
    <div class="pc-alert pc-alert-danger">Acesso restrito ao Super Admin.</div>
}
else
{
    <div class="pc-page-header">
        <div>
            <h1 class="pc-page-title">Unidades do Clube</h1>
            <p class="pc-page-subtitle">Gerenciamento global de unidades e designação de Admin (máx. 1 ativo por unidade) e Tesoureiro</p>
        </div>
        <button type="button" class="pc-btn pc-btn-primary" @onclick="NovaUnidade">+ Nova Unidade</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_mensagem))
    {
        <div class="pc-alert pc-alert-success" role="status">@_mensagem</div>
    }
    @if (!string.IsNullOrWhiteSpace(_erro))
    {
        <div class="pc-alert pc-alert-danger" role="alert">@_erro</div>
    }

    <PcModal IsOpen="_exibirFormUnidade"
             Title="@(_editandoId.HasValue ? "Editar Unidade" : "Cadastrar Nova Unidade")"
             Subtitle="Preencha os dados cadastrais e de contato da unidade"
             MaxWidth="720px"
             OnClose="() => _exibirFormUnidade = false">
        <ChildContent>
            <div class="pc-form-grid">
                <div class="pc-field">
                    <label class="pc-label">Nome da Unidade *</label>
                    <input class="pc-input" @bind="_nome" />
                </div>
                <div class="pc-field">
                    <label class="pc-label">Sigla *</label>
                    <input class="pc-input" @bind="_sigla" />
                </div>
                <div class="pc-field">
                    <label class="pc-label">Cidade *</label>
                    <input class="pc-input" @bind="_cidade" />
                </div>
                <div class="pc-field">
                    <label class="pc-label">UF (2 letras) *</label>
                    <input class="pc-input" maxlength="2" @bind="_uf" />
                </div>
                <div class="pc-field">
                    <label class="pc-label">Logradouro *</label>
                    <input class="pc-input" @bind="_logradouro" />
                </div>
                <div class="pc-field">
                    <label class="pc-label">Bairro *</label>
                    <input class="pc-input" @bind="_bairro" />
                </div>
                <div class="pc-field">
                    <label class="pc-label">Número *</label>
                    <input class="pc-input" @bind="_numero" />
                </div>
                <div class="pc-field">
                    <label class="pc-label">Telefone *</label>
                    <input class="pc-input" @bind="_fone" />
                </div>
                <div class="pc-field">
                    <label class="pc-label">E-mail *</label>
                    <input class="pc-input" @bind="_email" />
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _exibirFormUnidade = false">Cancelar</button>
            <button type="button" class="pc-btn pc-btn-primary" @onclick="SalvarUnidadeAsync">Salvar Unidade</button>
        </FooterContent>
    </PcModal>

    <div class="pc-card">
        <div class="pc-table-wrap">
            <table class="pc-table">
                <thead>
                    <tr>
                        <th>Sigla / Nome</th>
                        <th>Cidade / UF</th>
                        <th>Contato</th>
                        <th>Status</th>
                        <th>Admin Ativo</th>
                        <th>Tesoureiros</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in _unidades)
                    {
                        <tr>
                            <td><strong>@u.Sigla</strong> — @u.Nome</td>
                            <td>@u.Cidade / @u.UF</td>
                            <td>@u.Fone<br /><small style="color: var(--pc-text-secondary);">@u.Email</small></td>
                            <td><PcStatusBadge Text="@(u.Ativa ? "Ativa" : "Inativa")" Variant="@(u.Ativa ? "ativo" : "inativo")" /></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(u.AdminAtivoNome))
                                {
                                    <PcStatusBadge Text="@u.AdminAtivoNome" Variant="admin" />
                                }
                                else
                                {
                                    <PcStatusBadge Text="Sem administrador designado (Sob Super Admin)" Variant="info" />
                                }
                            </td>
                            <td>
                                @if (u.Tesoureiros.Count == 0)
                                {
                                    <span style="color: var(--pc-text-secondary);">Nenhum</span>
                                }
                                else
                                {
                                    <div style="display: flex; flex-direction: column; gap: 6px;">
                                        @foreach (var t in u.Tesoureiros)
                                        {
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                <PcStatusBadge Text="@t.NomeCompleto" Variant="tesoureiro" />
                                                <button type="button" class="pc-btn pc-btn-danger pc-btn-sm"
                                                        style="padding: 2px 8px; font-size: 11px;"
                                                        title="Remover cargo de Tesoureiro"
                                                        @onclick="() => RemoverTesoureiroAsync(u.Id, t.UsuarioId, t.NomeCompleto)">
                                                    Remover
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                    <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="() => EditarUnidade(u)">Editar</button>
                                    <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="() => AbrirDesignacao(u)">Designar Equipe</button>
                                    @if (u.AdminAtivoUsuarioId.HasValue)
                                    {
                                        <button type="button" class="pc-btn pc-btn-danger pc-btn-sm" @onclick="() => RemoverAdminAsync(u.Id)">Remover Admin</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <PcModal IsOpen="@(_unidadeDesignacao is not null)"
             Title="@($"Designar Admin ou Tesoureiro — {_unidadeDesignacao?.Nome}")"
             Subtitle="Selecione o associado pelo nome e escolha o cargo administrativo desejado para esta unidade."
             MaxWidth="640px"
             OnClose="() => _unidadeDesignacao = null">
        <ChildContent>
            <div class="pc-form-grid">
                <div class="pc-field">
                    <label class="pc-label">Associado / Usuário *</label>
                    <select class="pc-select" @bind="_usuarioIdDesignacao">
                        <option value="0">-- Selecione um associado --</option>
                        @foreach (var a in ObterAssociadosParaDesignacao())
                        {
                            <option value="@a.UsuarioId">
                                @a.NomeCompleto (@a.CpfMascarado — @a.Email) — @a.UnidadeNome [Atual: @ObterRotuloRole(a.RoleAdministrativa)]
                            </option>
                        }
                    </select>
                </div>
                <div class="pc-field">
                    <label class="pc-label">Role Administrativa</label>
                    <select class="pc-select" @bind="_roleDesignacao">
                        <option value="@RoleAdministrativa.Admin">Admin da Unidade (exclusivo)</option>
                        <option value="@RoleAdministrativa.Tesoureiro">Tesoureiro da Unidade</option>
                        <option value="@RoleAdministrativa.Nenhuma">Remover Role Administrativa</option>
                    </select>
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _unidadeDesignacao = null">Fechar</button>
            <button type="button" class="pc-btn pc-btn-primary" @onclick="ConfirmarDesignacaoAsync">Confirmar Designação</button>
        </FooterContent>
    </PcModal>
}

@code {
    private IReadOnlyList<UnidadeDto> _unidades = Array.Empty<UnidadeDto>();
    private IReadOnlyList<AssociadoDto> _associados = Array.Empty<AssociadoDto>();
    private string? _erro;
    private string? _mensagem;

    private bool _exibirFormUnidade;
    private int? _editandoId;
    private string _nome = string.Empty;
    private string _sigla = string.Empty;
    private string _logradouro = string.Empty;
    private string _bairro = string.Empty;
    private string _numero = string.Empty;
    private string _cidade = string.Empty;
    private string _uf = "PR";
    private string _fone = string.Empty;
    private string _email = string.Empty;

    private UnidadeDto? _unidadeDesignacao;
    private int _usuarioIdDesignacao;
    private RoleAdministrativa _roleDesignacao = RoleAdministrativa.Admin;

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsSuperAdmin)
            await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        var (data, err) = await Api.GetAsync<IReadOnlyList<UnidadeDto>>("api/v1/unidades");
        if (data is not null) _unidades = data;
        _erro = err;

        var (assocPage, _) = await Api.GetAsync<PagedResponse<AssociadoDto>>("api/v1/admin/associados?page=1&pageSize=100");
        if (assocPage is not null)
            _associados = assocPage.Items.Where(a => a.UsuarioId.HasValue).ToList();
    }

    private void NovaUnidade()
    {
        _editandoId = null;
        _nome = _sigla = _logradouro = _bairro = _numero = _cidade = _fone = _email = string.Empty;
        _uf = "PR";
        _exibirFormUnidade = true;
    }

    private void EditarUnidade(UnidadeDto u)
    {
        _editandoId = u.Id;
        _nome = u.Nome;
        _sigla = u.Sigla;
        _logradouro = u.Logradouro;
        _bairro = u.Bairro;
        _numero = u.Numero;
        _cidade = u.Cidade;
        _uf = u.UF;
        _fone = u.Fone;
        _email = u.Email;
        _exibirFormUnidade = true;
    }

    private async Task SalvarUnidadeAsync()
    {
        _erro = _mensagem = null;
        var req = new CriarOuAtualizarUnidadeRequest(_nome, _sigla, _logradouro, _bairro, _numero, _cidade, _uf, _fone, _email, true);
        var res = _editandoId.HasValue
            ? await Api.PutAsync<UnidadeDto>($"api/v1/unidades/{_editandoId.Value}", req)
            : await Api.PostAsync<UnidadeDto>("api/v1/unidades", req);

        if (res.Error is not null)
        {
            _erro = res.Error;
            return;
        }

        _exibirFormUnidade = false;
        _mensagem = "Unidade salva com sucesso.";
        await CarregarAsync();
    }

    private void AbrirDesignacao(UnidadeDto u)
    {
        _unidadeDesignacao = u;
        var candidatos = ObterAssociadosParaDesignacao();
        _usuarioIdDesignacao = u.AdminAtivoUsuarioId
            ?? candidatos.FirstOrDefault()?.UsuarioId
            ?? 0;
        _roleDesignacao = RoleAdministrativa.Admin;
    }

    private IReadOnlyList<AssociadoDto> ObterAssociadosParaDesignacao()
    {
        if (_unidadeDesignacao is null) return _associados;
        return _associados
            .OrderByDescending(a => a.UnidadeId == _unidadeDesignacao.Id)
            .ThenBy(a => a.NomeCompleto)
            .ToList();
    }

    private async Task ConfirmarDesignacaoAsync()
    {
        if (_unidadeDesignacao is null) return;
        _erro = _mensagem = null;

        if (_usuarioIdDesignacao <= 0)
        {
            _erro = "Selecione um associado válido para confirmar a designação.";
            return;
        }

        var res = await Api.PutAsync<UnidadeDto>(
            $"api/v1/unidades/{_unidadeDesignacao.Id}/administrador",
            new DesignarRoleUnidadeRequest(_usuarioIdDesignacao, _roleDesignacao));

        if (res.Error is not null)
        {
            _erro = res.Error;
            return;
        }

        _mensagem = "Designação administrativa atualizada com sucesso.";
        _unidadeDesignacao = null;
        await CarregarAsync();
    }

    private async Task RemoverAdminAsync(int unidadeId)
    {
        _erro = _mensagem = null;
        var res = await Api.PutAsync<UnidadeDto>(
            $"api/v1/unidades/{unidadeId}/administrador",
            new DesignarRoleUnidadeRequest(null, RoleAdministrativa.Admin));

        if (res.Error is not null)
        {
            _erro = res.Error;
            return;
        }

        _mensagem = "Administrador removido. A unidade permanece sob gestão direta do Super Admin.";
        await CarregarAsync();
    }

    private async Task RemoverTesoureiroAsync(int unidadeId, int usuarioId, string nomeTesoureiro)
    {
        _erro = _mensagem = null;
        var res = await Api.PutAsync<UnidadeDto>(
            $"api/v1/unidades/{unidadeId}/administrador",
            new DesignarRoleUnidadeRequest(usuarioId, RoleAdministrativa.Nenhuma));

        if (res.Error is not null)
        {
            _erro = res.Error;
            return;
        }

        _mensagem = $"Cargo de Tesoureiro removido de {nomeTesoureiro}.";
        await CarregarAsync();
    }

    private static string ObterRotuloRole(RoleAdministrativa role) => role switch
    {
        RoleAdministrativa.SuperAdmin => "Super Admin",
        RoleAdministrativa.Admin => "Admin",
        RoleAdministrativa.Tesoureiro => "Tesoureiro",
        _ => "Associado Comum"
    };
}
