@page "/financeiro"
@implements IDisposable
@inject ProClubesApiClient Api
@inject WebSessionState Session

<PageTitle>Financeiro e Mensalidades — ProClubesWeb</PageTitle>

<div class="pc-page-header">
    <div>
        <h1 class="pc-page-title">Módulo Financeiro e Mensalidades</h1>
        <p class="pc-page-subtitle">Parâmetros globais, tabela de valores por unidade/categoria, mensalidades por competência e quitação manual integral</p>
    </div>
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _exibirModalConfig = true">⚙ Parâmetros Globais</button>
        <button type="button" class="pc-btn pc-btn-primary" @onclick="() => _exibirModalNovoValor = true">+ Definir Novo Valor</button>
        <button type="button" class="pc-btn pc-btn-outline" @onclick="CarregarTudoAsync">Atualizar Dados</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_mensagem))
{
    <div class="pc-alert pc-alert-success">@_mensagem</div>
}
@if (!string.IsNullOrWhiteSpace(_erro))
{
    <div class="pc-alert pc-alert-danger">@_erro</div>
}

<PcModal IsOpen="_exibirModalConfig"
         Title="Parâmetros Globais de Cobrança"
         Subtitle="Vencimento ajustado ao último dia válido do mês (ex.: 31 em fev -> 28/29), sem prorrogação por feriado/fim de semana."
         MaxWidth="620px"
         OnClose="() => _exibirModalConfig = false">
    <ChildContent>
        <div class="pc-form-grid">
            <div class="pc-field">
                <label class="pc-label">Dia de Geração (1..31)</label>
                <input type="number" class="pc-input" disabled="@(!Session.IsSuperAdmin)" @bind="_diaGeracao" />
            </div>
            <div class="pc-field">
                <label class="pc-label">Dia de Vencimento (1..31)</label>
                <input type="number" class="pc-input" disabled="@(!Session.IsSuperAdmin)" @bind="_diaVencimento" />
            </div>
            <div class="pc-field">
                <label class="pc-label">Multa por Atraso (%)</label>
                <input type="number" step="0.01" class="pc-input" disabled="@(!Session.IsSuperAdmin)" @bind="_multa" />
            </div>
            <div class="pc-field">
                <label class="pc-label">Juros Simples Mensal (%)</label>
                <input type="number" step="0.01" class="pc-input" disabled="@(!Session.IsSuperAdmin)" @bind="_juros" />
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _exibirModalConfig = false">Fechar</button>
        @if (Session.IsSuperAdmin)
        {
            <button type="button" class="pc-btn pc-btn-primary" @onclick="SalvarConfigGlobalAsync">Salvar Parâmetros Globais</button>
        }
    </FooterContent>
</PcModal>

<PcModal IsOpen="_exibirModalNovoValor"
         Title="Definir Valor por Unidade e Categoria"
         Subtitle="Novos valores incidem somente a partir da competência seguinte, preservando cobranças já emitidas."
         MaxWidth="620px"
         OnClose="() => _exibirModalNovoValor = false">
    <ChildContent>
        <div class="pc-form-grid">
            <div class="pc-field">
                <label class="pc-label">UnidadeId</label>
                <input type="number" class="pc-input" disabled="@(!Session.IsSuperAdmin)" @bind="_unidIdValor" />
            </div>
            <div class="pc-field">
                <label class="pc-label">Categoria</label>
                <select class="pc-select" @bind="_catValor">
                    <option value="ASSOCIADO">Sócio Associado</option>
                    <option value="FUNDADOR">Sócio Fundador</option>
                    <option value="CONVIDADO">Sócio Convidado</option>
                </select>
            </div>
            <div class="pc-field">
                <label class="pc-label">Valor Mensal (R$)</label>
                <input type="number" step="0.01" class="pc-input" @bind="_novoValorMensal" />
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _exibirModalNovoValor = false">Cancelar</button>
        <button type="button" class="pc-btn pc-btn-secondary" @onclick="DefinirNovoValorAsync">Registrar Nova Vigência</button>
    </FooterContent>
</PcModal>

<div class="pc-card">
    <h3 style="margin-top: 0; font-size: 18px;">Tabela de Valores Vigentes e Históricos</h3>
    <div class="pc-table-wrap">
        <table class="pc-table">
            <thead>
                <tr>
                    <th>Unidade</th>
                    <th>Categoria</th>
                    <th>Valor</th>
                    <th>Início de Vigência</th>
                    <th>Fim de Vigência</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in _valores)
                {
                    <tr>
                        <td>@v.UnidadeNome</td>
                        <td>@v.CategoriaNome</td>
                        <td><strong>R$ @v.Valor.ToString("N2")</strong></td>
                        <td>@v.CompetenciaInicio.ToString("MM/yyyy")</td>
                        <td>@(v.CompetenciaFim?.ToString("MM/yyyy") ?? "Vigente")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="pc-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
        <div>
            <h3 style="margin: 0; font-size: 18px;">Mensalidades dos Associados</h3>
            <p class="pc-page-subtitle">Clique em um associado para consultar o histórico de competências e registrar quitações</p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <input class="pc-input" style="min-width: 240px;"
                   placeholder="Buscar por nome ou CPF..."
                   @bind="_buscaAssociado"
                   @bind:event="oninput" />
            <select class="pc-select" @bind="_filtroCategoria">
                <option value="">Todas as categorias</option>
                <option value="Sócio Associado">Sócio Associado</option>
                <option value="Sócio Convidado">Sócio Convidado</option>
                <option value="Sócio Fundador">Sócio Fundador</option>
            </select>
            <select class="pc-select" @bind="_filtroSituacao">
                <option value="">Todas as situações</option>
                <option value="VENCIDA">Com mensalidade vencida (Em atraso)</option>
                <option value="ABERTA">Com mensalidade em aberto</option>
                <option value="PAGA">Em dia (Somente pagas)</option>
            </select>
            @if (!string.IsNullOrWhiteSpace(_buscaAssociado) || !string.IsNullOrWhiteSpace(_filtroCategoria) || !string.IsNullOrWhiteSpace(_filtroSituacao))
            {
                <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="LimparFiltros">Limpar Filtros</button>
            }
        </div>
    </div>

    @{
        var associadosFiltrados = ObterAssociadosFiltrados();
    }

    <div class="pc-table-wrap">
        <table class="pc-table">
            <thead>
                <tr>
                    <th>Associado</th>
                    <th>Unidade / Categoria</th>
                    <th>Resumo de Mensalidades</th>
                    <th>Total Pendente Atualizado</th>
                    <th>Situação Financeira</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (associadosFiltrados.Count == 0)
                {
                    <tr><td colspan="6">Nenhum associado encontrado para os filtros selecionados.</td></tr>
                }
                @foreach (var assoc in associadosFiltrados)
                {
                    <tr style="cursor: pointer;" @onclick="() => AbrirModalAssociado(assoc)">
                        <td>
                            <strong>@assoc.AssociadoNome</strong> <small style="color: var(--pc-text-secondary);">(#@assoc.AssociadoId)</small><br />
                            <small>@assoc.CpfMascarado</small>
                        </td>
                        <td>
                            @assoc.UnidadeNome<br />
                            <small style="color: var(--pc-text-secondary);">@assoc.CategoriaNome</small>
                        </td>
                        <td>
                            <span style="font-size: 13px;">
                                <strong>@assoc.Mensalidades.Count</strong> total —
                                <span style="color: var(--pc-success);">@assoc.QtdPagas paga(s)</span> •
                                <span style="color: var(--pc-accent);">@assoc.QtdEmAberto em aberto</span> •
                                <span style="color: var(--pc-danger);">@assoc.QtdVencidas vencida(s)</span>
                            </span>
                        </td>
                        <td>
                            <strong>R$ @assoc.TotalPendenteAtualizado.ToString("N2")</strong>
                        </td>
                        <td>
                            <PcStatusBadge Text="@assoc.SituacaoGeral" Variant="@assoc.VarianteBadge" />
                        </td>
                        <td @onclick:stopPropagation="true">
                            <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="() => AbrirModalAssociado(assoc)">
                                Ver Mensalidades (@assoc.Mensalidades.Count)
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<PcModal IsOpen="@(_associadoSelecionado is not null)"
         Title="@($"Mensalidades — {_associadoSelecionado?.AssociadoNome}")"
         Subtitle="@($"CPF: {_associadoSelecionado?.CpfMascarado} | Unidade: {_associadoSelecionado?.UnidadeNome} | Categoria: {_associadoSelecionado?.CategoriaNome}")"
         MaxWidth="940px"
         OnClose="() => _associadoSelecionado = null">
    <ChildContent>
        @if (_associadoSelecionado is not null)
        {
            <div style="display: flex; justify-content: space-between; align-items: center; background: var(--pc-bg); padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
                <div>
                    <span style="color: var(--pc-text-secondary); font-size: 13px;">Resumo do Associado:</span>
                    <strong style="margin-left: 6px;">@_associadoSelecionado.QtdPagas paga(s)</strong> •
                    <strong>@_associadoSelecionado.QtdEmAberto em aberto</strong> •
                    <strong>@_associadoSelecionado.QtdVencidas vencida(s)</strong>
                </div>
                <div>
                    <span style="color: var(--pc-text-secondary); font-size: 13px;">Total Pendente Atualizado:</span>
                    <strong style="margin-left: 6px; color: var(--pc-primary); font-size: 16px;">R$ @_associadoSelecionado.TotalPendenteAtualizado.ToString("N2")</strong>
                </div>
            </div>

            <div class="pc-table-wrap">
                <table class="pc-table">
                    <thead>
                        <tr>
                            <th>Competência</th>
                            <th>Unidade / Categoria</th>
                            <th>Vencimento</th>
                            <th>Valor Principal</th>
                            <th>Multa + Juros</th>
                            <th>Total Atualizado</th>
                            <th>Status</th>
                            <th>Ação Manual</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _associadoSelecionado.Mensalidades)
                        {
                            <tr>
                                <td><strong>@m.Competencia.ToString("MM/yyyy")</strong></td>
                                <td>@m.UnidadeEmissoraNome<br /><small>@m.CategoriaNaEmissaoNome</small></td>
                                <td>@m.DataVencimento.ToString("dd/MM/yyyy")</td>
                                <td>R$ @m.ValorPrincipal.ToString("N2")</td>
                                <td>R$ @((m.ValorMultaCalculado + m.ValorJurosCalculado).ToString("N2")) @(m.DiasAtraso > 0 ? $"({m.DiasAtraso}d)" : "")</td>
                                <td><strong>R$ @m.ValorTotalAtualizado.ToString("N2")</strong></td>
                                <td>
                                    <PcStatusBadge Text="@m.SituacaoExibicao"
                                                   Variant="@(m.SituacaoExibicao == "Paga" ? "paga" : (m.SituacaoExibicao == "Vencida" ? "vencida" : "warning"))" />
                                    @if (m.Pagamento is not null)
                                    {
                                        <div><small>@m.Pagamento.FormaPagamento em @m.Pagamento.DataPagamento.ToString("dd/MM/yyyy")</small></div>
                                    }
                                </td>
                                <td>
                                    @if (m.Status == StatusMensalidade.Aberta)
                                    {
                                        <button type="button" class="pc-btn pc-btn-primary pc-btn-sm" @onclick="() => AbrirModalQuitacao(m)">Quitar Integral</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _associadoSelecionado = null">Fechar</button>
    </FooterContent>
</PcModal>

<PcModal IsOpen="@(_mensalidadeParaQuitar is not null)"
         Title="@($"Quitar Mensalidade — Competência {_mensalidadeParaQuitar?.Competencia:MM/yyyy}")"
         Subtitle="@($"{_mensalidadeParaQuitar?.AssociadoNome} ({_mensalidadeParaQuitar?.CpfMascarado}) — {_mensalidadeParaQuitar?.UnidadeEmissoraNome}")"
         MaxWidth="520px"
         OnClose="() => _mensalidadeParaQuitar = null">
    <ChildContent>
        @if (_mensalidadeParaQuitar is not null)
        {
            <div style="background: var(--pc-bg); padding: 14px; border-radius: 8px; margin-bottom: 14px;">
                <div>Valor Principal: <strong>R$ @_mensalidadeParaQuitar.ValorPrincipal.ToString("N2")</strong></div>
                <div>Multa + Juros: <strong>R$ @((_mensalidadeParaQuitar.ValorMultaCalculado + _mensalidadeParaQuitar.ValorJurosCalculado).ToString("N2"))</strong></div>
                <div style="margin-top: 6px; font-size: 16px;">Total a Quitar: <strong style="color: var(--pc-primary);">R$ @_mensalidadeParaQuitar.ValorTotalAtualizado.ToString("N2")</strong></div>
            </div>
        }
        <div class="pc-field">
            <label class="pc-label">Forma de Pagamento *</label>
            <select class="pc-select" @bind="_formaPagamentoSelecionada">
                @foreach (var fp in Enum.GetValues<FormaPagamento>())
                {
                    <option value="@fp">@fp</option>
                }
            </select>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _mensalidadeParaQuitar = null">Cancelar</button>
        <button type="button" class="pc-btn pc-btn-primary" @onclick="ConfirmarQuitacaoAsync">Confirmar Quitação Integral</button>
    </FooterContent>
</PcModal>

@code {
    private sealed record ResumoFinanceiroAssociado(
        int AssociadoId,
        string AssociadoNome,
        string CpfMascarado,
        string UnidadeNome,
        string CategoriaNome,
        int QtdPagas,
        int QtdEmAberto,
        int QtdVencidas,
        decimal TotalPendenteAtualizado,
        string SituacaoGeral,
        string VarianteBadge,
        IReadOnlyList<MensalidadeDto> Mensalidades);

    private ConfiguracaoFinanceiraDto? _config;
    private IReadOnlyList<ValorMensalidadeDto> _valores = Array.Empty<ValorMensalidadeDto>();
    private IReadOnlyList<MensalidadeDto> _mensalidades = Array.Empty<MensalidadeDto>();
    private IReadOnlyList<ResumoFinanceiroAssociado> _resumosPorAssociado = Array.Empty<ResumoFinanceiroAssociado>();
    private ResumoFinanceiroAssociado? _associadoSelecionado;
    private MensalidadeDto? _mensalidadeParaQuitar;
    private bool _exibirModalConfig;
    private bool _exibirModalNovoValor;
    private string _buscaAssociado = string.Empty;
    private string _filtroCategoria = string.Empty;
    private string _filtroSituacao = string.Empty;
    private FormaPagamento _formaPagamentoSelecionada = FormaPagamento.Pix;

    private byte _diaGeracao = 1;
    private byte _diaVencimento = 10;
    private decimal _multa = 2m;
    private decimal _juros = 1m;

    private int _unidIdValor = 1;
    private string _catValor = "ASSOCIADO";
    private decimal _novoValorMensal = 110m;

    private string? _erro;
    private string? _mensagem;

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += HandleContextChanged;
        _unidIdValor = Session.UnidadeContextoId ?? Session.Usuario?.UnidadeAdministrativaId ?? 1;
        await CarregarTudoAsync();
    }

    private async void HandleContextChanged()
    {
        if (Session.UnidadeContextoId.HasValue) _unidIdValor = Session.UnidadeContextoId.Value;
        await CarregarTudoAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CarregarTudoAsync()
    {
        _erro = null;
        var (cfg, errCfg) = await Api.GetAsync<ConfiguracaoFinanceiraDto>("api/v1/admin/financeiro/configuracao");
        if (cfg is not null)
        {
            _config = cfg;
            _diaGeracao = cfg.DiaGeracao;
            _diaVencimento = cfg.DiaVencimento;
            _multa = cfg.PercentualMulta;
            _juros = cfg.PercentualJuroMensal;
        }
        else if (errCfg is not null) _erro = errCfg;

        var urlVal = Session.UnidadeContextoId.HasValue
            ? $"api/v1/admin/financeiro/valores?unidadeId={Session.UnidadeContextoId.Value}"
            : "api/v1/admin/financeiro/valores";
        var (vals, _) = await Api.GetAsync<IReadOnlyList<ValorMensalidadeDto>>(urlVal);
        if (vals is not null) _valores = vals;

        await CarregarMensalidadesAsync();
    }

    private async Task CarregarMensalidadesAsync()
    {
        var q = new List<string> { "page=1", "pageSize=200" };
        if (Session.UnidadeContextoId.HasValue) q.Add($"unidadeId={Session.UnidadeContextoId.Value}");

        var (page, err) = await Api.GetAsync<PagedResponse<MensalidadeDto>>($"api/v1/admin/mensalidades?{string.Join("&", q)}");
        if (page is not null)
        {
            _mensalidades = page.Items;
            ConstruirResumosPorAssociado();
            if (_associadoSelecionado is not null)
            {
                _associadoSelecionado = _resumosPorAssociado.FirstOrDefault(r => r.AssociadoId == _associadoSelecionado.AssociadoId);
            }
        }
        if (err is not null) _erro = err;
    }

    private void ConstruirResumosPorAssociado()
    {
        _resumosPorAssociado = _mensalidades
            .GroupBy(m => m.AssociadoId)
            .Select(g =>
            {
                var lista = g.OrderByDescending(m => m.Competencia).ToList();
                var maisRecente = lista[0];
                var qtdPagas = lista.Count(m => m.SituacaoExibicao == "Paga");
                var qtdVencidas = lista.Count(m => m.SituacaoExibicao == "Vencida");
                var qtdEmAberto = lista.Count(m => m.SituacaoExibicao != "Paga" && m.SituacaoExibicao != "Vencida");
                var totalPendente = lista.Where(m => m.Status == StatusMensalidade.Aberta).Sum(m => m.ValorTotalAtualizado);

                string situacaoGeral;
                string variante;
                if (qtdVencidas > 0)
                {
                    situacaoGeral = "Em atraso (Vencida)";
                    variante = "vencida";
                }
                else if (qtdEmAberto > 0)
                {
                    situacaoGeral = "Em aberto";
                    variante = "warning";
                }
                else
                {
                    situacaoGeral = "Em dia (Paga)";
                    variante = "paga";
                }

                return new ResumoFinanceiroAssociado(
                    AssociadoId: g.Key,
                    AssociadoNome: maisRecente.AssociadoNome,
                    CpfMascarado: maisRecente.CpfMascarado,
                    UnidadeNome: maisRecente.UnidadeEmissoraNome,
                    CategoriaNome: maisRecente.CategoriaNaEmissaoNome,
                    QtdPagas: qtdPagas,
                    QtdEmAberto: qtdEmAberto,
                    QtdVencidas: qtdVencidas,
                    TotalPendenteAtualizado: totalPendente,
                    SituacaoGeral: situacaoGeral,
                    VarianteBadge: variante,
                    Mensalidades: lista);
            })
            .OrderBy(r => r.AssociadoNome)
            .ToList();
    }

    private IReadOnlyList<ResumoFinanceiroAssociado> ObterAssociadosFiltrados()
    {
        IEnumerable<ResumoFinanceiroAssociado> query = _resumosPorAssociado;

        if (!string.IsNullOrWhiteSpace(_buscaAssociado))
        {
            var termo = _buscaAssociado.Trim();
            query = query.Where(a =>
                a.AssociadoNome.Contains(termo, StringComparison.OrdinalIgnoreCase)
                || a.CpfMascarado.Contains(termo, StringComparison.OrdinalIgnoreCase)
                || a.AssociadoId.ToString() == termo);
        }

        if (!string.IsNullOrWhiteSpace(_filtroCategoria))
        {
            query = query.Where(a => string.Equals(a.CategoriaNome, _filtroCategoria, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_filtroSituacao))
        {
            query = _filtroSituacao switch
            {
                "VENCIDA" => query.Where(a => a.QtdVencidas > 0),
                "ABERTA" => query.Where(a => a.QtdEmAberto > 0),
                "PAGA" => query.Where(a => a.QtdVencidas == 0 && a.QtdEmAberto == 0 && a.QtdPagas > 0),
                _ => query
            };
        }

        return query.ToList();
    }

    private void LimparFiltros()
    {
        _buscaAssociado = string.Empty;
        _filtroCategoria = string.Empty;
        _filtroSituacao = string.Empty;
    }

    private void AbrirModalAssociado(ResumoFinanceiroAssociado assoc)
    {
        _associadoSelecionado = assoc;
    }

    private async Task SalvarConfigGlobalAsync()
    {
        _erro = _mensagem = null;
        var (cfg, err) = await Api.PutAsync<ConfiguracaoFinanceiraDto>(
            "api/v1/admin/financeiro/configuracao",
            new AtualizarConfiguracaoFinanceiraRequest(_diaGeracao, _diaVencimento, 7, _multa, _juros));
        if (err is not null) { _erro = err; return; }
        _config = cfg;
        _exibirModalConfig = false;
        _mensagem = "Configuração financeira global salva.";
    }

    private async Task DefinirNovoValorAsync()
    {
        _erro = _mensagem = null;
        var (_, err) = await Api.PostAsync<ValorMensalidadeDto>(
            "api/v1/admin/financeiro/valores",
            new DefinirValorMensalidadeRequest(_unidIdValor, _catValor, _novoValorMensal));
        if (err is not null) { _erro = err; return; }
        _exibirModalNovoValor = false;
        _mensagem = "Novo valor de mensalidade registrado para a competência seguinte.";
        await CarregarTudoAsync();
    }

    private void AbrirModalQuitacao(MensalidadeDto m)
    {
        _mensalidadeParaQuitar = m;
        _formaPagamentoSelecionada = FormaPagamento.Pix;
    }

    private async Task ConfirmarQuitacaoAsync()
    {
        if (_mensalidadeParaQuitar is null) return;
        _erro = _mensagem = null;
        var mensalidadeId = _mensalidadeParaQuitar.Id;
        var hoje = DateOnly.FromDateTime(DateTime.Now);
        var (_, err) = await Api.PostAsync<MensalidadeDto>(
            $"api/v1/admin/mensalidades/{mensalidadeId}/pagamentos",
            new RegistrarPagamentoMensalidadeRequest(hoje, _formaPagamentoSelecionada));
        if (err is not null) { _erro = err; return; }
        _mensalidadeParaQuitar = null;
        _mensagem = $"Pagamento integral da mensalidade #{mensalidadeId} registrado com sucesso.";
        await CarregarMensalidadesAsync();
    }

    public void Dispose()
    {
        Session.OnChange -= HandleContextChanged;
    }
}
