@page "/cadastros"
@implements IDisposable
@inject ProClubesApiClient Api
@inject WebSessionState Session

<PageTitle>Solicitações de Cadastro — ProClubesWeb</PageTitle>

@if (!Session.IsSuperAdmin && !Session.IsAdmin)
{
    <div class="pc-alert pc-alert-danger">Acesso permitido apenas a Admin da unidade ou Super Admin.</div>
}
else
{
    <div class="pc-page-header">
        <div class="pc-header-titles">
            <span class="pc-badge-eyebrow">ProClubes Enterprise • Admissão de Sócios</span>
            <h1 class="pc-title">Solicitações de Cadastro</h1>
            <p class="pc-subtitle">Aprovação com atribuição de categoria associativa ou rejeição com justificativa.</p>
        </div>
        <div class="pc-header-actions">
            <select class="pc-select" @bind="_filtroStatus" @bind:after="CarregarAsync" aria-label="Filtrar por status">
                <option value="">Todos os status</option>
                <option value="Pendente">Pendentes</option>
                <option value="Aprovada">Aprovadas</option>
                <option value="Rejeitada">Rejeitadas</option>
            </select>
            <button type="button" class="pc-btn pc-btn-outline" @onclick="CarregarAsync">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                </svg>
                Filtrar
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_mensagem))
    {
        <div class="pc-alert pc-alert-success">@_mensagem</div>
    }
    @if (!string.IsNullOrWhiteSpace(_erro))
    {
        <div class="pc-alert pc-alert-danger">@_erro</div>
    }

    <div class="pc-card">
        <div class="pc-table-wrap">
            <table class="pc-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Solicitante</th>
                        <th>Contato</th>
                        <th>Unidade Pretendida</th>
                        <th>Tipo / Categoria</th>
                        <th>Data Solicitação</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_solicitacoes.Count == 0)
                    {
                        <tr><td colspan="8">Nenhuma solicitação encontrada para os filtros atuais.</td></tr>
                    }
                    @foreach (var s in _solicitacoes)
                    {
                        <tr>
                            <td>#@s.Id</td>
                            <td>
                                <div class="pc-user-info">
                                    <div class="pc-avatar">@ObterIniciais(s.NomeCompleto)</div>
                                    <div>
                                        <div class="pc-user-name">@s.NomeCompleto</div>
                                        <div class="pc-user-meta">@s.CpfMascarado</div>
                                    </div>
                                </div>
                            </td>
                            <td>@s.Email<br /><small style="color: var(--pc-text-muted);">@s.Fone</small></td>
                            <td>@s.UnidadePretendidaNome</td>
                            <td>
                                @if (EhSolicitacaoDependente(s))
                                {
                                    <PcStatusBadge Text="Dependente" Variant="info" />
                                    <div style="margin-top: 4px;"><small style="color: var(--pc-text-muted);">@s.CategoriaAprovadaNome</small></div>
                                }
                                else if (!string.IsNullOrWhiteSpace(s.CategoriaAprovadaNome))
                                {
                                    <span class="pc-badge-category">@s.CategoriaAprovadaNome</span>
                                    <div style="margin-top: 4px;"><small style="color: var(--pc-text-muted);">@(s.Status == StatusSolicitacaoCadastro.Pendente ? "Categoria pretendida" : "Categoria aprovada")</small></div>
                                }
                                else
                                {
                                    <span style="color: var(--pc-text-muted);">—</span>
                                }
                            </td>
                            <td>@s.SolicitadaEm.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <PcStatusBadge Text="@s.Status.ToString()" Variant="@s.Status.ToString()" />
                                @if (!string.IsNullOrWhiteSpace(s.JustificativaRejeicao))
                                {
                                    <div><small style="color: var(--pc-danger);">Motivo: @s.JustificativaRejeicao</small></div>
                                }
                            </td>
                            <td>
                                <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
                                    <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="() => _solicitacaoDetalhes = s">Detalhes</button>
                                    @if (s.Status == StatusSolicitacaoCadastro.Pendente)
                                    {
                                        <button type="button" class="pc-btn pc-btn-primary pc-btn-sm" @onclick="() => AbrirModalAprovacao(s)">Aprovar</button>
                                        <button type="button" class="pc-btn pc-btn-danger pc-btn-sm" @onclick="() => AbrirModalRejeicao(s)">Rejeitar</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <PcModal IsOpen="@(_solicitacaoDetalhes is not null)"
             Title="@($"Detalhes da Solicitação #{_solicitacaoDetalhes?.Id}")"
             Subtitle="@($"{_solicitacaoDetalhes?.NomeCompleto} ({_solicitacaoDetalhes?.CpfMascarado})")"
             MaxWidth="640px"
             OnClose="() => _solicitacaoDetalhes = null">
        <ChildContent>
            @if (_solicitacaoDetalhes is not null)
            {
                <div style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 16px;">
                    <div class="pc-form-grid" style="gap: 12px;">
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Nome Completo</small>
                            <strong>@_solicitacaoDetalhes.NomeCompleto</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">CPF</small>
                            <strong>@_solicitacaoDetalhes.CpfMascarado</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Data de Nascimento</small>
                            <strong>@(_solicitacaoDetalhes.DataNascimento != default ? _solicitacaoDetalhes.DataNascimento.ToString("dd/MM/yyyy") : "Não informada")</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Sexo</small>
                            <strong>@(string.IsNullOrWhiteSpace(_solicitacaoDetalhes.Sexo) ? "Não informado" : _solicitacaoDetalhes.Sexo)</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Estado Civil</small>
                            <strong>@(string.IsNullOrWhiteSpace(_solicitacaoDetalhes.EstadoCivil) ? "Não informado" : _solicitacaoDetalhes.EstadoCivil)</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Telefone</small>
                            <strong>@(string.IsNullOrWhiteSpace(_solicitacaoDetalhes.Fone) ? "Não informado" : _solicitacaoDetalhes.Fone)</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">E-mail</small>
                            <strong>@(string.IsNullOrWhiteSpace(_solicitacaoDetalhes.Email) ? "Não informado" : _solicitacaoDetalhes.Email)</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Unidade Pretendida</small>
                            <strong>@_solicitacaoDetalhes.UnidadePretendidaNome</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Tipo / Categoria Solicitada</small>
                            <strong>@(string.IsNullOrWhiteSpace(_solicitacaoDetalhes.CategoriaAprovadaNome) ? "Sócio Associado" : _solicitacaoDetalhes.CategoriaAprovadaNome)</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Status da Solicitação</small>
                            <PcStatusBadge Text="@_solicitacaoDetalhes.Status.ToString()" Variant="@_solicitacaoDetalhes.Status.ToString()" />
                        </div>
                        <div style="grid-column: 1 / -1;">
                            <small style="color: var(--pc-text-secondary); display: block;">Endereço Completo</small>
                            <strong>@WebFormatHelpers.FormatarEndereco(_solicitacaoDetalhes.Logradouro, _solicitacaoDetalhes.Numero, _solicitacaoDetalhes.Bairro, _solicitacaoDetalhes.Cidade, _solicitacaoDetalhes.UF)</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Data da Solicitação</small>
                            <strong>@_solicitacaoDetalhes.SolicitadaEm.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                        <div>
                            <small style="color: var(--pc-text-secondary); display: block;">Data da Decisão</small>
                            <strong>@(_solicitacaoDetalhes.DecididaEm.HasValue ? _solicitacaoDetalhes.DecididaEm.Value.ToString("dd/MM/yyyy HH:mm") : "Aguardando análise")</strong>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_solicitacaoDetalhes.JustificativaRejeicao))
                        {
                            <div style="grid-column: 1 / -1;">
                                <small style="color: var(--pc-danger); display: block;">Justificativa da Rejeição</small>
                                <strong style="color: var(--pc-danger);">@_solicitacaoDetalhes.JustificativaRejeicao</strong>
                            </div>
                        }
                    </div>
                </div>
            }
        </ChildContent>
        <FooterContent>
            <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _solicitacaoDetalhes = null">Fechar</button>
            @if (_solicitacaoDetalhes?.Status == StatusSolicitacaoCadastro.Pendente)
            {
                <button type="button" class="pc-btn pc-btn-danger" @onclick="() => { var s = _solicitacaoDetalhes; _solicitacaoDetalhes = null; if (s is not null) AbrirModalRejeicao(s); }">Rejeitar</button>
                <button type="button" class="pc-btn pc-btn-primary" @onclick="() => { var s = _solicitacaoDetalhes; _solicitacaoDetalhes = null; if (s is not null) AbrirModalAprovacao(s); }">Aprovar</button>
            }
        </FooterContent>
    </PcModal>

    <PcModal IsOpen="@(_solicitacaoParaAprovar is not null)"
             Title="@($"Aprovar Solicitação #{_solicitacaoParaAprovar?.Id}")"
             Subtitle="@($"{_solicitacaoParaAprovar?.NomeCompleto} — Unidade: {_solicitacaoParaAprovar?.UnidadePretendidaNome}")"
             MaxWidth="520px"
             OnClose="() => _solicitacaoParaAprovar = null">
        <ChildContent>
            @if (EhSolicitacaoDependente(_solicitacaoParaAprovar))
            {
                <div class="pc-field" style="background: var(--pc-bg); border: 1px solid var(--pc-border); border-radius: 10px; padding: 14px; margin-bottom: 0;">
                    <label class="pc-label">Vínculo Solicitado</label>
                    <div style="font-weight: 600; color: var(--pc-text-main); margin-bottom: 4px;">@_solicitacaoParaAprovar?.CategoriaAprovadaNome</div>
                    <small style="color: var(--pc-text-muted);">A aprovação ativará o vínculo de dependente junto ao associado titular na unidade @_solicitacaoParaAprovar?.UnidadePretendidaNome.</small>
                </div>
            }
            else
            {
                <div class="pc-field">
                    <label class="pc-label">Categoria Associativa a Conceder *</label>
                    <select class="pc-select" @bind="_categoriaAprovacao">
                        <option value="ASSOCIADO">Sócio Associado</option>
                        <option value="FUNDADOR">Sócio Fundador</option>
                        <option value="CONVIDADO">Sócio Convidado</option>
                        <option value="SIMPATIZANTE">Simpatizante</option>
                    </select>
                    @if (!string.IsNullOrWhiteSpace(_solicitacaoParaAprovar?.CategoriaAprovadaNome))
                    {
                        <div style="margin-top: 6px;">
                            <small style="color: var(--pc-text-muted);">Categoria pretendida no cadastro: <strong>@_solicitacaoParaAprovar.CategoriaAprovadaNome</strong></small>
                        </div>
                    }
                </div>
            }
        </ChildContent>
        <FooterContent>
            <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _solicitacaoParaAprovar = null">Cancelar</button>
            <button type="button" class="pc-btn pc-btn-primary" @onclick="ConfirmarAprovacaoAsync">Confirmar Aprovação</button>
        </FooterContent>
    </PcModal>

    <PcModal IsOpen="@(_solicitacaoParaRejeitar is not null)"
             Title="@($"Rejeitar Solicitação #{_solicitacaoParaRejeitar?.Id}")"
             Subtitle="@($"{_solicitacaoParaRejeitar?.NomeCompleto} ({_solicitacaoParaRejeitar?.CpfMascarado})")"
             MaxWidth="540px"
             OnClose="() => _solicitacaoParaRejeitar = null">
        <ChildContent>
            <div class="pc-field">
                <label class="pc-label">Justificativa da Rejeição (obrigatória) *</label>
                <textarea class="pc-textarea" rows="3" placeholder="Informe o motivo da rejeição para ciência e correção do solicitante..." @bind="_justificativaRejeicao"></textarea>
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="pc-btn pc-btn-outline" @onclick="() => _solicitacaoParaRejeitar = null">Cancelar</button>
            <button type="button" class="pc-btn pc-btn-danger" @onclick="ConfirmarRejeicaoAsync">Confirmar Rejeição</button>
        </FooterContent>
    </PcModal>
}

@code {
    private IReadOnlyList<SolicitacaoCadastroListItemDto> _solicitacoes = Array.Empty<SolicitacaoCadastroListItemDto>();
    private string _filtroStatus = "Pendente";
    private string _categoriaAprovacao = "ASSOCIADO";
    private SolicitacaoCadastroListItemDto? _solicitacaoDetalhes;
    private SolicitacaoCadastroListItemDto? _solicitacaoParaAprovar;
    private SolicitacaoCadastroListItemDto? _solicitacaoParaRejeitar;
    private string _justificativaRejeicao = string.Empty;
    private string? _erro;
    private string? _mensagem;

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += HandleContextChanged;
        await CarregarAsync();
    }

    private async void HandleContextChanged()
    {
        await CarregarAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CarregarAsync()
    {
        _erro = null;
        var q = new List<string> { "page=1", "pageSize=50" };
        if (Session.UnidadeContextoId.HasValue) q.Add($"unidadeId={Session.UnidadeContextoId.Value}");
        if (!string.IsNullOrWhiteSpace(_filtroStatus)) q.Add($"status={_filtroStatus}");

        var (data, err) = await Api.GetAsync<PagedResponse<SolicitacaoCadastroListItemDto>>($"api/v1/admin/cadastros/solicitacoes?{string.Join("&", q)}");
        if (data is not null) _solicitacoes = data.Items;
        _erro = err;
    }

    private void AbrirModalAprovacao(SolicitacaoCadastroListItemDto s)
    {
        _solicitacaoParaAprovar = s;
        _categoriaAprovacao = EhSolicitacaoDependente(s)
            ? "DEPENDENTE"
            : MapearNomeParaCodigoCategoria(s.CategoriaAprovadaNome);
    }

    private void AbrirModalRejeicao(SolicitacaoCadastroListItemDto s)
    {
        _solicitacaoParaRejeitar = s;
        _justificativaRejeicao = string.Empty;
    }

    private async Task ConfirmarAprovacaoAsync()
    {
        if (_solicitacaoParaAprovar is null) return;
        _erro = _mensagem = null;
        var id = _solicitacaoParaAprovar.Id;
        var (_, err) = await Api.PostAsync<SolicitacaoCadastroListItemDto>($"api/v1/admin/cadastros/solicitacoes/{id}/aprovar", new AprovarSolicitacaoRequest(_categoriaAprovacao));
        if (err is not null) { _erro = err; return; }
        _solicitacaoParaAprovar = null;
        _mensagem = _categoriaAprovacao == "DEPENDENTE"
            ? $"Solicitação #{id} aprovada como Dependente."
            : $"Solicitação #{id} aprovada na categoria {_categoriaAprovacao}.";
        await CarregarAsync();
    }

    private static bool EhSolicitacaoDependente(SolicitacaoCadastroListItemDto? s) =>
        s?.CategoriaAprovadaNome?.StartsWith("Dependente", StringComparison.OrdinalIgnoreCase) == true;

    private static string MapearNomeParaCodigoCategoria(string? nomeCategoria)
    {
        if (string.IsNullOrWhiteSpace(nomeCategoria)) return "ASSOCIADO";
        if (nomeCategoria.Contains("Fundador", StringComparison.OrdinalIgnoreCase)) return "FUNDADOR";
        if (nomeCategoria.Contains("Convidado", StringComparison.OrdinalIgnoreCase)) return "CONVIDADO";
        if (nomeCategoria.Contains("Simpatizante", StringComparison.OrdinalIgnoreCase)) return "SIMPATIZANTE";
        return "ASSOCIADO";
    }

    private async Task ConfirmarRejeicaoAsync()
    {
        if (_solicitacaoParaRejeitar is null) return;
        _erro = _mensagem = null;
        var (_, err) = await Api.PostAsync<SolicitacaoCadastroListItemDto>(
            $"api/v1/admin/cadastros/solicitacoes/{_solicitacaoParaRejeitar.Id}/rejeitar",
            new RejeitarSolicitacaoRequest(_justificativaRejeicao));

        if (err is not null) { _erro = err; return; }
        _mensagem = $"Solicitação #{_solicitacaoParaRejeitar.Id} rejeitada com justificativa.";
        _solicitacaoParaRejeitar = null;
        _justificativaRejeicao = string.Empty;
        await CarregarAsync();
    }

    private static string ObterIniciais(string nomeCompleto)
    {
        if (string.IsNullOrWhiteSpace(nomeCompleto)) return "PC";
        var partes = nomeCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1) return partes[0][..Math.Min(2, partes[0].Length)].ToUpperInvariant();
        return $"{char.ToUpperInvariant(partes[0][0])}{char.ToUpperInvariant(partes[^1][0])}";
    }

    public void Dispose()
    {
        Session.OnChange -= HandleContextChanged;
    }
}
