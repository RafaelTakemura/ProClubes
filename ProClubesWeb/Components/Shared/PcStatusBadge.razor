@namespace ProClubesWeb.Components.Shared

<span class="pc-badge pc-badge-soft @CssClass" role="status">
    <span>@Text</span>
</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public string Variant { get; set; } = "info";
    [Parameter] public bool SoftTint { get; set; } = true;

    private string CssClass => Variant.ToLowerInvariant() switch
    {
        "success" or "aprovada" or "paga" or "confirmada" or "aberta_votacao" or "concluida" or "ativo" or "aceito" => "pc-badge-success",
        "warning" or "pendente" or "ematendimento" or "pendenteaceite" or "aguardandoaceitecontrato" => "pc-badge-warning",
        "danger" or "rejeitada" or "vencida" or "cancelada" or "inativo" or "recusado" or "cancelado" => "pc-badge-danger",
        "superadmin" => "pc-badge-superadmin",
        "admin" => "pc-badge-admin",
        "tesoureiro" => "pc-badge-tesoureiro",
        "fundador" => "pc-badge-fundador",
        "neutral" or "simpatizante" => "pc-badge-neutral",
        _ => "pc-badge-info"
    };
}
