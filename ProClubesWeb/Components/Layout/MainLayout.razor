@inherits LayoutComponentBase
@implements IDisposable
@inject WebSessionState Session
@inject ProClubesApiClient Api
@inject NavigationManager Nav

@if (!Session.IsAuthenticated)
{
    <div style="min-height: 100vh; background: var(--pc-bg);">
        <ProClubesWeb.Components.Pages.Login />
    </div>
}
else
{
    <div class="pc-shell">
        <aside class="pc-sidebar" aria-label="Navegação administrativa ProClubes">
            <div class="pc-sidebar-brand">
                <img src="/images/proclubes-logo.svg" alt="Logotipo ProClubes" />
                <div>
                    <div class="pc-sidebar-brand-title">ProClubes</div>
                    <div style="font-size: 11px; color: rgba(255, 255, 255, 0.65); letter-spacing: 0.03em;">PAINEL DA DIRETORIA</div>
                </div>
            </div>
            <NavMenu />
            <div style="padding: 16px 20px; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 11px; color: rgba(255, 255, 255, 0.55);">
                ProClubes Enterprise • Governança
            </div>
        </aside>

        <div class="pc-main">
            <header class="pc-topbar">
                <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                    @if (Session.IsSuperAdmin)
                    {
                        <label for="seletor-unidade" class="pc-label" style="margin: 0; color: var(--pc-text-secondary); text-transform: uppercase; letter-spacing: 0.03em;">Escopo de Unidade:</label>
                        <select id="seletor-unidade" class="pc-select" style="min-width: 240px;"
                                value="@(Session.UnidadeContextoId?.ToString() ?? "")"
                                @onchange="OnUnidadeContextoChanged">
                            <option value="">Todas as Unidades (Global)</option>
                            @foreach (var u in _unidades)
                            {
                                <option value="@u.Id">@u.Nome (@u.Sigla)</option>
                            }
                        </select>
                    }
                    else
                    {
                        <span class="pc-badge pc-badge-info">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M3 21h18"></path>
                                <path d="M5 21V7l8-4v18"></path>
                                <path d="M19 21V11l-6-4"></path>
                            </svg>
                            <span>Unidade: @(Session.Usuario?.UnidadeAdministrativaNome ?? "Vinculada")</span>
                        </span>
                    }
                </div>

                <div style="display: flex; align-items: center; gap: 14px;">
                    @if (Session.Usuario is not null)
                    {
                        <PcStatusBadge Text="@ObterRotuloRole(Session.Usuario.RoleAdministrativa)"
                                       Variant="@ObterVarianteRole(Session.Usuario.RoleAdministrativa)" />
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <div class="pc-avatar" style="width: 32px; height: 32px; font-size: 11px;">@ObterIniciais(Session.Usuario.NomeCompleto)</div>
                            <span style="font-weight: 600; font-size: 14px; color: var(--pc-text-primary);">@Session.Usuario.NomeCompleto</span>
                        </div>
                    }

                    <a href="/notificacoes" class="pc-btn pc-btn-outline pc-btn-sm" aria-label="Central de notificações">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <span>Notificações</span>
                        @if (Session.NotificacoesNaoLidas > 0)
                        {
                            <span class="pc-bell-counter" title="@Session.NotificacoesNaoLidas não lidas">@Session.NotificacoesNaoLidas</span>
                        }
                    </a>

                    <button type="button" class="pc-btn pc-btn-outline pc-btn-sm" @onclick="SairAsync">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>Sair</span>
                    </button>
                </div>
            </header>

            <main class="pc-page">
                @Body
            </main>
        </div>
    </div>
}

@code {
    private IReadOnlyList<UnidadeDto> _unidades = Array.Empty<UnidadeDto>();

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += HandleSessionChanged;
        if (Session.IsAuthenticated && Session.IsSuperAdmin)
        {
            var res = await Api.GetAsync<IReadOnlyList<UnidadeDto>>("api/v1/unidades");
            if (res.Data is not null)
                _unidades = res.Data;
        }
    }

    private async void HandleSessionChanged()
    {
        if (Session.IsAuthenticated && Session.IsSuperAdmin && _unidades.Count == 0)
        {
            var res = await Api.GetAsync<IReadOnlyList<UnidadeDto>>("api/v1/unidades");
            if (res.Data is not null)
                _unidades = res.Data;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void OnUnidadeContextoChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (int.TryParse(val, out var id))
            Session.SetUnidadeContexto(id);
        else
            Session.SetUnidadeContexto(null);
    }

    private async Task SairAsync()
    {
        await Api.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    private static string ObterIniciais(string nomeCompleto)
    {
        if (string.IsNullOrWhiteSpace(nomeCompleto)) return "PC";
        var partes = nomeCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1) return partes[0][..Math.Min(2, partes[0].Length)].ToUpperInvariant();
        return $"{char.ToUpperInvariant(partes[0][0])}{char.ToUpperInvariant(partes[^1][0])}";
    }

    private static string ObterRotuloRole(RoleAdministrativa r) => r switch
    {
        RoleAdministrativa.SuperAdmin => "Super Admin",
        RoleAdministrativa.Admin => "Admin da Unidade",
        RoleAdministrativa.Tesoureiro => "Tesoureiro",
        _ => "Usuário"
    };

    private static string ObterVarianteRole(RoleAdministrativa r) => r switch
    {
        RoleAdministrativa.SuperAdmin => "superadmin",
        RoleAdministrativa.Admin => "admin",
        RoleAdministrativa.Tesoureiro => "tesoureiro",
        _ => "info"
    };

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChanged;
    }
}
